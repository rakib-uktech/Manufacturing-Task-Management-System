@page
@model TPLPLM.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="modal fade show" id="profileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true" style="display: block;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="profileModalLabel">Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="closeProfileModal"></button>
            </div>
            <div class="modal-body">
                <partial name="_StatusMessage" for="StatusMessage" />
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Username" class="form-control" placeholder="Username" disabled />
                        <label asp-for="Username" class="form-label"></label>
                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="form-floating mb-3">
                            <select asp-for="Input.SelectedUserId" class="form-control" asp-items="Model.UserList">
                                <option value="">-- Select User --</option>
                            </select>
                            <label asp-for="Input.SelectedUserId">Select User</label>
                        </div>

                        <div class="form-floating mb-3">
                            <select asp-for="Input.SelectedRole" class="form-control">
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>
                            <label asp-for="Input.SelectedRole">Select Role</label>
                        </div>

                        <div class="form-floating mb-3">
                            <select asp-for="Input.SelectedShiftId" class="form-control" asp-items="Model.ShiftList">
                                <option value="">-- Select Shift --</option>
                            </select>
                            <label asp-for="Input.SelectedShiftId">Select Shift</label>
                        </div>
                    }
                    else
                    {
                        <div class="form-floating mb-3">
                            <input class="form-control" value="@Model.Input.SelectedRole" disabled />
                            <label>Role</label>
                        </div>
                    }

                    <button type="submit" class="w-100 btn btn-lg btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalEl = document.getElementById('profileModal');
            const myModal = new bootstrap.Modal(modalEl, { backdrop: 'static', keyboard: false });
            myModal.show();

            document.getElementById("closeProfileModal").addEventListener("click", function () {
                window.location.href = "/";
            });

            const userSelect = document.querySelector('[name="Input.SelectedUserId"]');
            const roleSelect = document.querySelector('[name="Input.SelectedRole"]');

            if (userSelect && roleSelect) {
                userSelect.addEventListener("change", function () {
                    const userId = this.value;
                    if (!userId) return;

                    fetch(`?handler=UserRoles&userId=${userId}`)
                        .then(response => response.json())
                        .then(data => {
                            roleSelect.value = Array.isArray(data) && data.length > 0 ? data[0] : "";
                        })
                        .catch(err => console.error("Error loading roles:", err));
                });
                userSelect.dispatchEvent(new Event('change'));
            }
        });
    </script>
}