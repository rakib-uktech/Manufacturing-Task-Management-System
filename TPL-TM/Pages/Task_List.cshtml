@page
@model TPL_TM.Pages.Task_ListModel
@{
}
<div class="container">
    <!-- Added pt-5 and mt-5 for spacing below navbar -->
    <!-- Task List Table -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow p-3">
                <div class="container-fluid bg-success text-white py-3 mb-4 rounded shadow">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h2 class="mb-0">
                                <i class="bi bi-list-task me-2"></i> Task List
                            </h2>
                            <p class="mb-0">Manage and track all tasks efficiently.</p>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <a href="Assign_Task" class="btn btn-light text-success me-2">
                                <i class="bi bi-plus-circle me-1"></i> Assign New Task
                            </a>
                            <a id="exportBtn" class="btn btn-outline-light" href="javascript:void(0);">
                                <i class="bi bi-download me-1"></i> Export Tasks
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Task Search Input -->
                <input type="text" id="taskSearch" class="form-control mb-3" placeholder="Search tasks...">

                <!-- Task Table -->
                <div class="table-responsive">
                    <table id="taskTable" class="table table-striped table-bordered table-hover" style="width:100%">
                        <thead class="bg-success text-white">
                            <tr>
                                <th class="text-center">Action</th>
                                <th>ID</th>
                                <th>Create_On</th>
                                <th>Ref_No</th>
                                <th>Task_Type</th>
                                <th>Task_Name</th>
                                <th>Task_Description</th>
                                <th>Assign_To</th>
                                <th>Qty</th>
                                <th>Unit</th>
                                <th>Status</th>
                                <th>Priority_Level</th>
                                <th>Complete_On</th>
                                <th>Duration</th>
                                <th>Created_by</th>
                                <th>Completed_by</th>
                                <th>Comments</th>
                            </tr>
                        </thead>
                        <tbody id="taskTableBody">
                            @foreach (var task in Model.listtask)
                            {
                                <tr>
                                    <td class="text-center">
                                        <div class="dropdown">
                                            <a href="#" class="btn btn-link p-0 text-decoration-none"
                                               id="dropdownMenuButton_@task.Id"
                                               data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                                            </a>
                                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton_@task.Id">
                                                <li>
                                                    <a class="dropdown-item" href="Complete_Task?id=@task.Id">
                                                        <i class="bi bi-check2-circle me-1"></i> Complete Task
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="/Edit_Task?id=@task.Id">
                                                        <i class="bi bi-pencil-square me-1"></i> Edit Task
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="/Delete_Task?id=@task.Id"
                                                       onclick="return confirm('Are you sure you want to delete this task?');">
                                                        <i class="bi bi-trash me-1"></i> Delete Task
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                    <td>@task.Id</td>
                                    <td>@task.Create_On</td>
                                    <td>@task.Ref_No</td>
                                    <td>@task.Task_Type</td>
                                    <td>@task.Task_Name</td>
                                    <td>@task.Task_Description</td>
                                    <td>@task.Assign_To</td>
                                    <td>@task.Qty</td>
                                    <td>@task.Unit</td>
                                    <td>@task.Status</td>
                                    <td>@task.Priority_Level</td>
                                    <td>@task.Complete_On</td>
                                    <td>@task.Duration</td>
                                    <td>@task.Created_by</td>
                                    <td>@task.Completed_by</td>
                                    <td>@task.Comments</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        $(document).ready(function () {
            var table = $('#taskTable').DataTable({
                responsive: true,
                paging: true,
                lengthMenu: [5, 10, 25, 50, 100, 1000, 5000, 10000, 100000],
                pageLength: 10,
                ordering: true,
                searching: true,
                autoWidth: false,
                language: {
                    search: "🔍 Search:",
                    lengthMenu: "Show _MENU_ tasks per page",
                    zeroRecords: "No matching tasks found",
                    info: "Showing _START_ to _END_ of _TOTAL_ tasks",
                    infoFiltered: "(filtered from _MAX_ total tasks)",
                    paginate: {
                        previous: "←",
                        next: "→"
                    }
                }
            });

            $('#taskSearch').on('keyup', function () {
                table.search(this.value).draw();
            });
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            $('#taskSearch').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('#taskTableBody tr').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        document.getElementById("exportBtn").addEventListener("click", function () {
            var table = document.getElementById("taskTable");
            var workbook = XLSX.utils.table_to_book(table, { sheet: "Tasks" });
            XLSX.writeFile(workbook, "Task_List.xlsx");
        });
    </script>
}
