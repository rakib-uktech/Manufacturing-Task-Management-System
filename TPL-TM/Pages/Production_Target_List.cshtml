@page
@model TPL_TM.Pages.Production_Target_ListModel

<div class="container">

    <div class="row">
        <div class="col-12">
            <div class="card shadow p-3">

                <div class="container-fluid bg-success text-white py-3 mb-4 rounded shadow">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h2 class="mb-0">
                                <i class="bi bi-speedometer2 me-2"></i> Production Target List
                            </h2>
                            <p class="mb-0">Manage and track production targets efficiently.</p>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <a href="/Production_Target" class="btn btn-light text-primary">
                                <i class="bi bi-plus-circle me-1"></i> Add New Target
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Search -->
                <input type="text" id="targetSearch" class="form-control mb-3" placeholder="Search production targets...">

                <div class="table-responsive">
                    <table id="targetTable" class="table table-striped table-bordered table-hover" style="width:100%">
                        <thead class="bg-success text-white">
                            <tr>
                                <th class="text-center">Action</th>
                                <th>ID</th>
                                <th>Machine Line</th>
                                <th>Machine Name</th>
                                <th>Product Line</th>
                                <th>Target Count</th>
                                <th>Effective Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="targetTableBody">
                            @foreach (var item in Model.Targets)
                            {
                                <tr>
                                    <td class="text-center">
                                        <div class="dropdown">
                                            <a href="#" class="btn btn-link p-0 text-decoration-none"
                                               id="dropdownMenuButton_@item.Id"
                                               data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                                            </a>
                                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton_@item.Id">
                                                <li>
                                                    <a class="dropdown-item" href="/Production_Target?id=@item.Id">
                                                        <i class="bi bi-pencil-square me-1"></i> Edit
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="/Production_Target_List?deleteId=@item.Id"
                                                       onclick="return confirm('Are you sure you want to delete this target?');">
                                                        <i class="bi bi-trash me-1"></i> Delete
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                    <td>@item.Id</td>
                                    <td>@item.Machine_Line</td>
                                    <td>@item.Machine_Name</td>
                                    <td>@item.Product_Line</td>
                                    <td>@item.Target_Count</td>
                                    <td>@item.Effective_Date.ToString("yyyy-MM-dd")</td>
                                    <td>@(item.Is_Active ? "✅ Active" : "❌ Inactive")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#targetTable').DataTable({
                responsive: true,
                paging: true,
                lengthMenu: [5, 10, 25, 50, 100],
                pageLength: 10,
                ordering: true,
                searching: true,
                autoWidth: false,
                language: {
                    search: "🔍 Search:",
                    lengthMenu: "Show _MENU_ entries",
                }
            });

            $('#targetSearch').on('keyup', function () {
                table.search(this.value).draw();
            });
        });
    </script>
}