@page
@model TPL_TM.Pages.Operator_IndexModel
@{
    ViewData["Title"] = "Operator Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Operator Dashboard</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f5f7fa;
        }

        .dashboard-title {
            font-weight: 700;
            color: #198754;
        }

        .dashboard-subtitle {
            color: #6c757d;
        }

        .container {
            max-width: 1600px;
            margin: 0 auto;
            padding-inline: 1rem;
        }

        .card {
            border: none;
            border-radius: 1.25rem;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            min-width: 220px;
            margin-inline: auto;
            width: 100%;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            }

        .flash {
            animation: flash 1s infinite;
        }

        @@keyframes flash {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }

        .btn-lg {
            border-radius: 1rem;
            font-weight: 600;
            transition: all 0.3s ease-in-out;
        }

            .btn-lg:hover {
                transform: scale(1.03);
                box-shadow: 0 6px 18px rgba(25, 135, 84, 0.25);
            }

        .alert a {
            font-weight: 600;
            color: #198754;
            text-decoration: none;
        }

            .alert a:hover {
                text-decoration: underline;
            }

        /* ✅ Tablet + Responsive Fixes */
        @@media (max-width: 1200px) {
            .row-cols-xl-4 > *

        {
            flex: 0 0 33.3333%;
            max-width: 33.3333%;
        }

        }

        @@media (max-width: 992px) {
            .row-cols-lg-3 > *

        {
            flex: 0 0 50%;
            max-width: 50%;
        }

        }

        @@media (max-width: 768px) {
            .row-cols-md-2 > *

        {
            flex: 0 0 100%;
            max-width: 100%;
        }

        }

        @@media (max-width: 576px) {
            .card

        {
            margin-bottom: 1rem;
        }

        }
    </style>
</head>

<body>
    <div class="container mt-5">
        <!-- Header -->
        <div class="text-center mb-4">
            <h1 class="display-5 dashboard-title">👷 Operator Dashboard</h1>
            <p class="lead dashboard-subtitle">
                Monitor your last shift performance and production summary.
            </p>
            <hr class="my-4" />
        </div>

        <!-- Summary Cards -->
        <div class="row g-4 mb-5 justify-content-center text-center row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4">

            <!-- Shift Letter with Ratings -->
            <div class="col d-flex">
                <div class="card shadow-sm border-0 rounded-4 bg-info text-white flex-fill">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center">
                        <i class="bi bi-clipboard-data fs-2 mb-2"></i>
                        <h6 class="fw-bold">Shift Letter</h6>
                        <h3 class="mb-2">@Model.ShiftLetter</h3>

                        <!-- Shift Rating -->
                        <p class="mb-0">
                            <strong>Self Rating:</strong>
                            @for (int i = 0; i < Model.CurrentShift?.Shift_Rating; i++)
                            {
                                <span>★</span>
                            }
                        </p>
                    </div>
                </div>
            </div>

            <!-- Shift Status -->
            <div class="col d-flex">
                <div class="card shadow-sm border-0 rounded-4 flex-fill @(Model.ShiftActive ? "bg-success text-white" : "bg-secondary text-white")">
                    <div class="card-body d-flex flex-column justify-content-center">
                        <i class="bi bi-clock-history fs-2 mb-2"></i>
                        <h6 class="fw-bold">Shift Status</h6>
                        <h3 class="mb-0">@Model.ShiftStatus</h3>
                        @if (Model.ShiftActive && Model.ShiftStartTime.HasValue)
                        {
                            <p class="small mt-2 mb-0">
                                <i class="bi bi-play-circle me-1"></i>
                                Started @Model.ShiftStartTime.Value.ToString("t")
                            </p>
                        }
                        else if (!Model.ShiftActive && Model.ShiftEndTime.HasValue)
                        {
                            <p class="small mt-2 mb-0">
                                <i class="bi bi-stop-circle me-1"></i>
                                Completed @Model.ShiftEndTime.Value.ToString("t")
                            </p>
                        }
                        else
                        {
                            <p class="small mt-2 mb-0 fst-italic text-warning">No previous shift data</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Quality Checked -->
            <div class="col d-flex">
                <div class="card shadow-sm border-0 rounded-4 bg-success text-white flex-fill" id="qualityCard"
                     data-last-check="@Model.LastQualityCheckedOn?.ToString("o")">
                    <div class="card-body d-flex flex-column justify-content-center">
                        <i class="bi bi-clipboard-check fs-2 mb-2"></i>
                        <h6 class="fw-bold">Quality Checked</h6>
                        <h3 class="mb-0">@Model.TotalQualityChecked</h3>
                        @if (Model.LastQualityCheckedOn.HasValue)
                        {
                            <p class="small mt-2 mb-0">
                                <i class="bi bi-clock me-1"></i>
                                Last Checked: @Model.LastQualityCheckedOn.Value.ToString("t")
                            </p>
                        }
                        else
                        {
                            <p class="small mt-2 mb-0 fst-italic text-warning">No checks recorded</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Waste Collected -->
            <div class="col d-flex">
                <div class="card shadow-sm border-0 rounded-4 bg-danger text-white flex-fill">
                    <div class="card-body d-flex flex-column justify-content-center">
                        <i class="bi bi-trash3 fs-2 mb-2"></i>
                        <h6 class="fw-bold">Waste Collected</h6>
                        <h3 class="mb-0">@Model.TotalWasteCollected</h3>
                    </div>
                </div>
            </div>

            <!-- Total Downtime -->
            <div class="col d-flex">
                <div class="card shadow-sm border-0 rounded-4 bg-warning text-dark flex-fill">
                    <div class="card-body d-flex flex-column justify-content-center">
                        <i class="bi bi-clock fs-2 mb-2"></i>
                        <h6 class="fw-bold">Total Downtime</h6>
                        <h3 class="mb-0">
                            @{
                                int totalMinutes = Model.TotalDowntimeMinutes;
                                int hours = totalMinutes / 60;
                                int minutes = totalMinutes % 60;
                            }
                            @($"{hours}h {minutes}m")
                        </h3>
                    </div>
                </div>
            </div>

            <!-- Total Production -->
            <div class="col d-flex">
                <div class="card shadow-sm border-0 rounded-4 bg-primary text-white flex-fill">
                    <div class="card-body d-flex flex-column justify-content-center">
                        <i class="bi bi-speedometer2 fs-2 mb-2"></i>
                        <h6 class="fw-bold">Total Production</h6>
                        <h3 class="mb-0">@Model.TotalProduction</h3>
                    </div>
                </div>
            </div>

        </div>

        <!-- Shift Action -->
        <div class="text-center mt-4">
            <form method="post">
                <button type="submit" asp-page-handler="StartShift" class="btn btn-lg btn-success shadow-sm px-5">
                    <i class="bi bi-play-circle me-2"></i> Start New Shift
                </button>
            </form>
        </div>
        <!-- Production Scheduler -->
        <div class="text-center mt-3">
            <a asp-page="/Workorder_Scheduler"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-lg btn-primary shadow-sm px-5">
                <i class="bi bi-calendar3 me-2"></i> Production Scheduler
            </a>
        </div>
        <div class="text-center mt-3">
            <a asp-area="Identity" asp-page="/Account/Logout"
               class="btn btn-lg btn-danger shadow-sm px-5">
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const qualityCard = document.getElementById("qualityCard");
            if (!qualityCard) return;

            const lastCheckAttr = qualityCard.getAttribute("data-last-check");
            const lastCheck = lastCheckAttr ? new Date(lastCheckAttr) : null;
            const OVERDUE_MINUTES = 15;

            function startFlashing() { qualityCard.classList.add("flash"); }
            function stopFlashing() { qualityCard.classList.remove("flash"); }

            function evaluateFlash() {
                const now = new Date();
                if (!lastCheck) {
                    startFlashing();
                    return;
                }
                const diffMinutes = (now - lastCheck) / 1000 / 60;
                if (diffMinutes > OVERDUE_MINUTES) startFlashing();
                else stopFlashing();
            }

            evaluateFlash();
            setInterval(evaluateFlash, 60000);
        });
    </script>
</body>
</html>
