@page
@model TPL_TM.Pages.Material_Consumption_EditModel
@{
}

<div class="modal fade show" id="editMaterialModal" tabindex="-1" aria-labelledby="editMaterialModalLabel"
     aria-hidden="true" style="display:block;">
    <div class="modal-dialog modal-dialog-centered" style="margin-top:80px;">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="editMaterialModalLabel">
                    @(Model.Material.Id > 0 ? "Update Material Consumption" : "Add Material Consumption")
                </h5>
                <button type="button" class="btn-close" id="closeMaterialModal"></button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <form method="post">
                    <input type="hidden" name="Id" value="@Model.Material.Id" />

                    <div class="form-floating mb-3">
                        <input type="number" class="form-control" name="Shift_Id" value="@Model.Material.Shift_Id" required />
                        <label>Shift ID</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input class="form-control" name="Wo_Number" value="@Model.Material.Wo_Number" required />
                        <label>WO Number</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input class="form-control" name="Material_Id" value="@Model.Material.Material_Id" required />
                        <label>Material ID</label>
                    </div>

                    <div class="form-floating mb-3">
                        <textarea class="form-control" name="Material_Description" style="height:80px;">@Model.Material.Material_Description</textarea>
                        <label>Description</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="number" step="0.01" class="form-control" name="Quantity_Consumed"
                               value="@Model.Material.Quantity_Consumed" required />
                        <label>Quantity Consumed</label>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100">
                        @(Model.Material.Id > 0 ? "Update Material" : "Add Material")
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const isUser = @User.IsInRole("User").ToString().ToLower();

            var m = new bootstrap.Modal(
                document.getElementById('editMaterialModal'),
                {
                    backdrop: 'static',
                    keyboard: false
                }
            );
            m.show();

            document
                .getElementById("closeMaterialModal")
                .addEventListener("click", function () {

                    if (isUser) {
                        window.location.href = "/Operator_Index";
                    } else {
                        window.location.href = "/Material_Consumption_Report";
                    }
                });
        });
    </script>
}

