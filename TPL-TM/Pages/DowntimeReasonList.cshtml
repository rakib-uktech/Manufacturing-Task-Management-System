@page
@model TPL_TM.Pages.DowntimeReasonListModel

<div class="container mt-4">
    <div class="card shadow p-3">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3><i class="bi bi-list-check"></i> Downtime Reason List</h3>

            <div class="d-flex gap-2">
                <button id="exportBtn" class="btn btn-outline-success">
                    <i class="bi bi-download"></i> Export
                </button>

                <a href="/DowntimeReasonModel" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Add New Reason
                </a>
            </div>
        </div>

        <input id="reasonSearch" class="form-control mb-3" placeholder="Search downtime reasons..." />

        <div class="table-responsive">
            <table id="reasonTable" class="table table-striped table-bordered">
                <thead class="table-success">
                    <tr>
                        <th>Actions</th>
                        <th>ID</th>
                        <th>Reason Name</th>
                        <th>Description</th>
                        <th>Machine Type</th> <!-- Added -->
                        <th>Active</th>
                        <th>Created On</th>
                        <th>Created By</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var r in Model.DowntimeReasonList)
                    {
                        <tr>
                            <td>
                                <div class="dropdown">
                                    <a class="btn btn-link p-0" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </a>

                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" href="/DowntimeReasonEdit?id=@r.Id">
                                                <i class="bi bi-pencil-square text-warning"></i> Edit
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="/DowntimeReasonDelete?id=@r.Id"
                                               onclick="return confirm('Delete this reason?');">
                                                <i class="bi bi-trash text-danger"></i> Delete
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>

                            <td>@r.Id</td>
                            <td>@r.ReasonName</td>
                            <td>@r.Description</td>
                            <td>@r.Machine_Type</td> <!-- Display Machine Type -->
                            <td>@(r.Active ? "Yes" : "No")</td>
                            <td>@r.CreatedOn?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@r.CreatedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script>
        $(document).ready(function () {

            var table = $('#reasonTable').DataTable({
                pageLength: 10
            });

            $('#reasonSearch').keyup(function () {
                table.search(this.value).draw();
            });

            $('#exportBtn').click(function () {
                var wb = XLSX.utils.table_to_book(document.getElementById("reasonTable"));
                XLSX.writeFile(wb, "Downtime_Reason_List.xlsx");
            });
        });
    </script>
}
