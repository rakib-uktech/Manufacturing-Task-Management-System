@page
@model TPL_TM.Pages.Quality_Check_TemplateModel

<div class="modal fade show" style="display:block;" id="templateModal">
    <div class="modal-dialog modal-dialog-centered" style="max-width:450px;">
        <div class="modal-content shadow-lg rounded-4">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Add Quality Check Template</h5>
                <a href="/Quality_Check_Template_List" class="btn-close btn-close-white"></a>
            </div>

            <div class="modal-body">

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success">@Model.SuccessMessage</div>
                }

                <form method="post">

                    <!-- Product Category Dropdown -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Product Category</label>
                        <select asp-for="ProductCategory" class="form-select" required>
                            <option value="">Select Product Category</option>
                            @foreach (var category in Model.ProductCategoryList)
                            {
                                <option value="@category">@category</option>
                            }
                        </select>
                    </div>

                    <!-- Test Name -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Test Name</label>
                        <input asp-for="TestName" class="form-control" placeholder="e.g. Wet Test" required />
                    </div>

                    <button class="btn btn-primary w-100">
                        <i class="bi bi-plus-circle me-1"></i>Add Template
                    </button>

                </form>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const modal = new bootstrap.Modal(document.getElementById("templateModal"), {
            backdrop: "static", keyboard: false
        });
        modal.show();
    });
</script>