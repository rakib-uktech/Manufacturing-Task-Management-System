@page "/Quality_Check_Report"
@model TPL_TM.Pages.Quality_Check_ReportModel

<div class="container-fluid">
    <div class="card shadow p-3">

        <!-- HEADER -->
        <div class="bg-success text-white p-3 mb-3 rounded">
            <div class="d-flex justify-content-between">
                <div>
                    <h4 class="mb-0">
                        <i class="bi bi-clipboard-check"></i> Quality Check Report
                    </h4>
                    <small>View, edit, or delete quality checks</small>
                </div>
                <div>
                    <a href="/Quality_Check" class="btn btn-light btn-sm me-2">
                        <i class="bi bi-plus-circle"></i> Add
                    </a>
                    <button id="exportBtn" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-download"></i> Export
                    </button>
                </div>
            </div>
        </div>

        <!-- FILTERS -->
        <div class="d-flex gap-2 mb-3">
            <input id="qualitySearch" class="form-control form-control-sm" placeholder="Search..." />

            <select id="rangeSelect" class="form-select form-select-sm w-auto">
                <option value="7">Last 7 days</option>
                <option value="30">Last 30 days</option>
                <option value="all" selected>All</option>
                <option value="custom">Custom</option>
            </select>

            <input type="date" id="fromDate" class="form-control form-control-sm" disabled />
            <input type="date" id="toDate" class="form-control form-control-sm" disabled />
            <button id="applyBtn" class="btn btn-success btn-sm" disabled>Apply</button>

            <select id="pageLength" class="form-select form-select-sm w-auto ms-auto">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>

        <!-- TABLE -->
        <table id="qualityTable" class="table table-striped table-bordered w-100">
            <thead class="bg-success text-white">
                <tr>
                    <th>Actions</th>
                    <th>Test Name</th>
                    <th>Status</th>
                    <th>Fail</th>
                    <th>Weights</th>
                    <th>Comment</th>
                    <th>Check Time</th>
                    <th>Created By</th>
                    <th>Created On</th>
                    <th>Shift ID</th>
                    <th>Machine Line</th>
                    <th>Machine Name</th>
                    <th>Product Line</th>
                </tr>
            </thead>
        </table>

    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(function () {

            var table = $('#qualityTable').DataTable({
                processing: true,
                serverSide: true,
                searching: false,
                pageLength: 10,

                ajax: {
                    url: '@Url.Page("/Quality_Check_Report", "LoadData")',
                    type: 'GET',

                    // 🔥 CRITICAL FIX (DataTables parameter mapping)
                    data: function (d) {
                        return {
                            draw: d.draw,
                            start: d.start,
                            length: d.length,

                            search: $('#qualitySearch').val(),
                            range: $('#rangeSelect').val(),
                            fromDate: $('#fromDate').val(),
                            toDate: $('#toDate').val()
                        };
                    }
                },

                columns: [
                    {
                        data: 'actions',
                        orderable: false,
                        render: function (id) {
                            return `
                                <div class="dropdown text-center">
                                    <a href="#"
                                       class="d-inline-flex align-items-center justify-content-center"
                                       style="width: 28px; height: 28px;"
                                       data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </a>

                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2"
                                               href="/Quality_Check_Edit?id=${id}">
                                                <i class="fas fa-edit text-primary"></i>
                                                Edit
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2 text-danger"
                                               href="/Quality_Check_Delete?id=${id}"
                                               onclick="return confirm('Are you sure?')">
                                                <i class="fas fa-trash"></i>
                                                Delete
                                            </a>
                                        </li>
                                    </ul>
                                </div>`;
                        }
                    },
                    { data: 'testName' },
                    { data: 'status' },
                    { data: 'fail' },
                    { data: 'weights' },
                    { data: 'comment' },
                    { data: 'checkTime' },
                    { data: 'createdBy' },
                    { data: 'createdOn' },
                    { data: 'shiftId' },
                    { data: 'machineLine' },
                    { data: 'machineName' },
                    { data: 'productLine' }
                ]
            });

            $('#qualitySearch').keyup(function () {
                table.draw();
            });

            $('#pageLength').change(function () {
                table.page.len(this.value).draw();
            });

            $('#rangeSelect').change(function () {
                var isCustom = this.value === "custom";
                $('#fromDate,#toDate,#applyBtn').prop('disabled', !isCustom);
                if (!isCustom) table.draw();
            });

            $('#applyBtn').click(function () {
                table.draw();
            });

            $('#exportBtn').click(function () {
                const params = new URLSearchParams({
                    search: $('#qualitySearch').val(),
                    range: $('#rangeSelect').val(),
                    fromDate: $('#fromDate').val(),
                    toDate: $('#toDate').val()
                });

                window.location = '@Url.Page("/Quality_Check_Report", "Export")' + '&' + params.toString();
            });

        });
    </script>

    <style>
        .dropdown-item i {
            width: 16px;
        }

        .dropdown-menu {
            min-width: 140px;
        }
    </style>
}