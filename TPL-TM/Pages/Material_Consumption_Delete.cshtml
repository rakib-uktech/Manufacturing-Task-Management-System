@page
@model TPL_TM.Pages.Material_Consumption_DeleteModel
@{
    ViewData["Title"] = "Delete Material Record";
}

<div class="modal fade show" id="deleteMaterialModal" tabindex="-1" aria-labelledby="deleteMaterialModalLabel" aria-hidden="true" style="display: block;">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteMaterialModalLabel">Confirm Delete</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                        onclick="window.location.href = redirectUrl">
                </button>
            </div>


            <div class="modal-body">
                @if (!string.IsNullOrEmpty(Model.errorMessage))
                {
                    <div class="alert alert-danger">@Model.errorMessage</div>
                }
                else
                {
                    <h5 class="text-danger">Are you sure you want to delete this material record?</h5>

                    <table class="table table-bordered table-hover table-sm align-middle" style="background-color: #f9f9f9;">
                        <tbody>
                            <tr><th style="width: 30%;">Shift ID:</th><td>@Model.material.Shift_Id</td></tr>
                            <tr><th>WO Number:</th><td>@Model.material.Wo_Number</td></tr>
                            <tr><th>Material ID:</th><td>@Model.material.Material_Id</td></tr>
                            <tr><th>Description:</th><td>@Model.material.Material_Description</td></tr>
                            <tr><th>Quantity Consumed:</th><td>@Model.material.Quantity_Consumed</td></tr>
                        </tbody>
                    </table>

                    <form method="post" asp-page-handler="DeleteMaterial" novalidate>
                        <input type="hidden" name="Id" value="@Model.material.Id" />
                        <button type="submit" class="btn btn-danger w-100">Delete Material</button>
                        <a href="/Material_Consumption_Report" class="btn btn-secondary w-100 mt-2">Cancel</a>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteMaterialModal'), {
                backdrop: 'static',
                keyboard: false
            });
            deleteModal.show();
        });
    </script>
    <script>
        const redirectUrl = "@(
            User.IsInRole("User")
                    ? "/Operator_Index"
                    : "/Material_Consumption_Report"
        )";
    </script>

}
