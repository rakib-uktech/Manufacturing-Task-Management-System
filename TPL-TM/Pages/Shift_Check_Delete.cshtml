@page
@model TPL_TM.Pages.Shift_Check_DeleteModel
@{
    ViewData["Title"] = "Delete Shift Check";
}

<div class="modal fade show" id="deleteShiftCheckModal" tabindex="-1"
     aria-labelledby="deleteShiftCheckModalLabel" aria-hidden="true" style="display: block;">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteShiftCheckModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" aria-label="Close"
                        onclick="window.location.href='/Shift_Check_Report'"></button>
            </div>

            <div class="modal-body">

                @if (!string.IsNullOrEmpty(Model.errorMessage))
                {
                    <div class="alert alert-danger">@Model.errorMessage</div>
                }
                else
                {
                    <h5 class="text-danger">Are you sure you want to delete this shift check?</h5>

                    <table class="table table-bordered table-hover table-sm" style="background-color: #fafafa;">
                        <tbody>
                            <tr><th>ID</th><td>@Model.ShiftCheck.Id</td></tr>
                            <tr><th>Check Name</th><td>@Model.ShiftCheck.Check_Name</td></tr>
                            <tr><th>Status</th><td>@(Model.ShiftCheck.Check_Status ? "Yes" : "No")</td></tr>
                            <tr><th>Comment</th><td>@Model.ShiftCheck.Check_Comment</td></tr>
                            <tr><th>Created By</th><td>@Model.ShiftCheck.Check_Created_By</td></tr>
                            <tr><th>Shift Created On</th><td>@Model.ShiftCheck.Shift_Created_On</td></tr>
                        </tbody>
                    </table>

                    <form method="post" asp-page-handler="DeleteShiftCheck">
                        <input type="hidden" name="Id" value="@Model.ShiftCheck.Id" />

                        <button type="submit" class="btn btn-danger w-100">
                            Delete Shift Check
                        </button>
                        <a href="/Shift_Check_Report" class="btn btn-secondary w-100 mt-2">
                            Cancel
                        </a>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var modal = new bootstrap.Modal(document.getElementById('deleteShiftCheckModal'), {
                backdrop: 'static',
                keyboard: false
            });
            modal.show();
        });
    </script>
}
