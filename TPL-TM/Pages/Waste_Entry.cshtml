@page
@model TPL_TM.Pages.Waste_EntryModel
@{
}

<!-- Waste Entry Modal -->
<div class="modal fade show" id="wasteEntryModal" tabindex="-1" aria-labelledby="wasteEntryModalLabel" aria-hidden="true" style="display:block;">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 550px; margin-top:80px;">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header bg-primary text-white d-flex align-items-center rounded-top-4">
                <i class="bi bi-recycle me-2 fs-4"></i>
                <h5 class="modal-title fw-semibold" id="wasteEntryModalLabel">Add Waste Entry</h5>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal" aria-label="Close" id="closeWasteEntryModal"></button>
            </div>

            <div class="modal-body p-4">
                <form id="waste-entry-form" method="post" novalidate class="needs-validation">

                    <!-- Hidden Shift ID -->
                    <input type="hidden" name="Shift_Id" value="@Model.WasteInfo.Shift_Id" />

                    <!-- Waste Type -->
                    <div class="form-floating mb-3">
                        <select class="form-select" name="Waste_Type" id="Waste_Type" required>
                            <option value="">Select Waste Type</option>
                            @foreach (var type in Model.WasteTypeList)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                        <label for="Waste_Type">
                            <i class="bi bi-tags me-1 text-primary"></i>Waste Type
                        </label>
                        <div class="invalid-feedback">Please select a waste type.</div>
                    </div>

                    <!-- Waste Weight -->
                    <div class="form-floating mb-4">
                        <input type="number" step="0.01" name="Waste_Weight" id="Waste_Weight" class="form-control" placeholder="Waste Weight" required />
                        <label for="Waste_Weight">
                            <i class="bi bi-speedometer2 me-1 text-primary"></i>Waste Weight (kg)
                        </label>
                        <div class="invalid-feedback">Please enter a valid weight.</div>
                    </div>

                    <!-- Submit -->
                    <button type="submit" class="btn btn-lg btn-success w-100 shadow-sm rounded-3">
                        <i class="bi bi-check-circle me-2"></i>Save Waste Entry
                    </button>
                </form>
                @{
                    var totalWaste = Model.WasteEntries.Sum(w => w.Waste_Weight ?? 0);
                }

                <div class="alert alert-warning d-flex justify-content-between align-items-center rounded-3 shadow-sm mt-3 mb-2">
                    <div>
                        <i class="bi bi-trash me-2"></i>
                        <strong>Total Waste (kg)</strong>
                    </div>
                    <span class="badge bg-danger fs-6 px-3 py-2">
                        @totalWaste
                    </span>
                </div>

                @if (Model.WasteEntries.Any())
                {
                    <button class="btn btn-outline-primary btn-sm d-flex justify-content-between align-items-center toggle-btn"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#waste-@Model.WasteInfo.Shift_Id"
                            aria-expanded="true"
                            aria-controls="waste-@Model.WasteInfo.Shift_Id">
                        <span>
                            <i class="bi bi-trash me-1"></i> View Waste Details
                        </span>
                        <i class="bi bi-chevron-down chevron"></i>
                    </button>


                    <div class="collapse mt-2" id="waste-@Model.WasteInfo.Shift_Id">
                        <div class="materials-table-container mt-2">
                            <table class="table table-sm table-hover align-middle materials-table mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-center">Actions</th>
                                        <th>Weight</th>
                                        <th>Waste Type</th>
                                        <th>Created By</th>
                                        <th>Created On</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var w in Model.WasteEntries)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <div class="dropdown">
                                                    <a href="#" class="btn btn-link p-0" data-bs-toggle="dropdown">
                                                        <i class="bi bi-three-dots-vertical text-muted"></i>
                                                    </a>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li>
                                                            <a class="dropdown-item"
                                                               href="/Waste_Edit?id=@w.Id">
                                                                <i class="bi bi-pencil-square me-2 text-warning"></i>
                                                                Edit
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item text-danger"
                                                               href="/Waste_Delete?id=@w.Id"
                                                               onclick="return confirm('Delete this waste entry?');">
                                                                <i class="bi bi-trash me-2"></i>
                                                                Delete
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                            <td>@w.Waste_Weight</td>
                                            <td>@w.Waste_Type</td>
                                            <td>@w.Created_By</td>
                                            <td>@w.Created_At?.ToString("g")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted small fst-italic mt-2 mb-0">
                        No waste recorded yet.
                    </p>
                }

            </div>
        </div>
    </div>
   
</div>

@section Scripts {
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        /* Smooth modal animation */
        .modal-content {
            animation: fadeInDown 0.4s ease-in-out;
        }

        @@keyframes fadeInDown {
            from

        {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        /* Form label icons */
        .form-floating > label i {
            font-size: 0.95rem;
        }

        /* Button hover for consistency */
        .btn-success:hover {
            background-color: #218838 !important;
        }
    </style>
    <style>
        /* === COLLAPSE BUTTON (same as Downtime / Production) === */
        .btn-outline-primary {
            border: 1px solid #0d6efd;
            color: #0d6efd;
            font-weight: 500;
            background-color: #f8faff;
            border-radius: 0.75rem;
            transition: all 0.2s ease-in-out;
            width: 100%;
        }

            .btn-outline-primary:hover {
                background-color: #0d6efd;
                color: white;
                box-shadow: 0 2px 8px rgba(13,110,253,0.2);
            }

        /* === TABLE CONTAINER === */
        .materials-table-container {
            max-height: 260px;
            overflow-y: auto;
            overflow-x: auto;
        }

        /* === TABLE STYLE === */
        .materials-table {
            border-radius: 0.75rem;
            background: #f9fafb;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
            font-size: 0.9rem;
            width: 100%;
            white-space: nowrap;
        }

            .materials-table thead {
                background-color: #e9f5ff;
                color: #0d6efd;
                font-weight: 600;
                position: sticky;
                top: 0;
                z-index: 2;
            }

            .materials-table tbody tr:hover {
                background-color: #f1f9ff;
                transition: background-color 0.2s ease-in-out;
            }

        /* === CHEVRON ROTATION === */
        .chevron {
            transition: transform 0.3s ease;
        }

            .chevron.rotate {
                transform: rotate(180deg);
            }
    </style>
    <script>
        document.querySelectorAll('.toggle-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                btn.querySelector('.chevron')?.classList.toggle('rotate');
            });
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = new bootstrap.Modal(document.getElementById('wasteEntryModal'), {
                backdrop: 'static',
                keyboard: false
            });
            modal.show();

            // Redirect on close
            document.getElementById("closeWasteEntryModal").addEventListener("click", function () {
                window.location.href = "/Shift_Dashboard";
            });

            // Form validation
            (function () {
                'use strict';
                const form = document.getElementById('waste-entry-form');
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            })();
        });
    </script>
}
