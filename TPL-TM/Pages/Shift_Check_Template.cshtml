@page
@model TPL_TM.Pages.Shift_Check_TemplateModel

<div class="modal fade show" style="display:block;" id="templateModal">
    <div class="modal-dialog modal-dialog-centered" style="max-width:450px;">
        <div class="modal-content shadow-lg rounded-4">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Add Shift Check Template</h5>
                <a href="/Shift_Check_Template_List" class="btn-close btn-close-white"></a>
            </div>

            <div class="modal-body">

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success">@Model.SuccessMessage</div>
                }

                <form method="post">

                    <!-- Check Name -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Check Name</label>
                        <input asp-for="CheckName" class="form-control" placeholder="e.g. Area Cleaned" required />
                    </div>

                    <button class="btn btn-primary w-100">
                        <i class="bi bi-plus-circle me-1"></i>Add Template
                    </button>

                </form>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const modal = new bootstrap.Modal(document.getElementById("templateModal"), {
            backdrop: "static", keyboard: false
        });
        modal.show();
    });
</script>
