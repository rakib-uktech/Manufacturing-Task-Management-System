@page
@model ScheduleCalendarModel
@{
    ViewData["Title"] = "Task Schedule";
    var next7Days = Enumerable.Range(0, 7).Select(offset => Model.SelectedStartDate.AddDays(offset)).ToList();
    var hours = Enumerable.Range(0, 24).ToList();

    var tasksByDay = Model.ScheduledTasks
        .Where(t => t.Task_Date.HasValue && t.Task_StartTime.HasValue && t.Task_EndTime.HasValue &&
                    next7Days.Contains(t.Task_Date.Value.Date))
        .GroupBy(t => t.Task_Date.Value.Date)
        .ToDictionary(g => g.Key, g => g.ToList());

    var renderedTasks = new Dictionary<string, int>();
    var remainingSpans = new Dictionary<string, int>();
}
<head>
    <style>
        .task-card {
            background-color: #e8f5e9;
            border-radius: 8px;
            transition: all 0.3s ease-in-out;
            position: relative;
            overflow: hidden;
        }

            .task-card:hover {
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
                transform: scale(1.03);
                background-color: #d0f0da;
            }

        .task-hover-content {
            opacity: 0.9;
            transition: opacity 0.3s ease-in-out;
        }

        .task-card:hover .task-hover-content {
            opacity: 1;
        }

        .btn-transparent {
            background-color: transparent;
            border: none;
            box-shadow: none;
        }

    </style>
</head>
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="card shadow p-3">
                <div class="container-fluid bg-success text-white py-3 mb-4 rounded shadow">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h2 class="mb-0">
                                <i class="bi bi-list-task me-2"></i> Task Schedule
                            </h2>
                            <p class="mb-0">Manage and track all tasks efficiently.</p>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <a href="Task_Schedule" class="btn btn-light text-success me-2">
                                <i class="bi bi-plus-circle me-1"></i> Add New Schedule
                            </a>
                            <a id="exportBtn" class="btn btn-outline-light" href="javascript:void(0);">
                                <i class="bi bi-download me-1"></i> Export Schedule
                            </a>
                        </div>
                    </div>
                </div>

                <form method="post" id="filterForm">
                    <div class="row mb-3 align-items-center">
                        <div class="col-md-auto mb-2 mb-md-0 d-flex align-items-center">
                            <label for="startDatePicker" class="form-label me-2 mb-0">Select Start Date:</label>
                            <input type="date" id="startDatePicker" name="SelectedStartDate" class="form-control" style="max-width: 180px;"
                                   value="@Model.SelectedStartDate.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="col-md-auto mb-2 mb-md-0 d-flex align-items-center">
                            <label for="machineSelector" class="form-label me-2 mb-0">Assign To (Machine):</label>
                            <select id="machineSelector" name="SelectedMachine" class="form-select" style="max-width: 180px;">
                                <option value="All" selected="@(Model.SelectedMachine == "All")">All Machines</option>
                                @foreach (var machine in Model.AvailableMachines.Where(m => m != "All"))
                                {
                                    <option value="@machine" selected="@(machine == Model.SelectedMachine)">@machine</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-auto ms-auto mb-2 mb-md-0">
                            <input type="text" id="taskSearch" class="form-control" placeholder="Search tasks...">
                        </div>
                    </div>
                </form>

                <div class="table-responsive">
                    <table id="taskTable" class="table table-striped table-bordered table-hover" style="width:100%">
                        <thead class="bg-success text-white">
                            <tr>
                                <th>Hour</th>
                                @foreach (var day in next7Days)
                                {
                                    <th>@day.ToString("ddd, MMM d")</th>
                                }
                            </tr>
                        </thead>
                        <tbody id="taskTableBody">
                            @foreach (var hour in hours)
                            {
                                <tr>
                                    <td class="fw-bold">@hour.ToString("00"):00</td>
                                    @foreach (var day in next7Days)
                                    {
                                        var key = $"{day:yyyyMMdd}-{hour}";

                                        if (remainingSpans.TryGetValue(key, out var skipCount) && skipCount > 0)
                                        {
                                            remainingSpans[key] = skipCount - 1;
                                            continue;
                                        }

                                        if (tasksByDay.TryGetValue(day, out var tasks))
                                        {
                                            var task = tasks.FirstOrDefault(t => t.Task_StartTime.Value.Hours == hour);
                                            if (task != null)
                                            {
                                                var taskKey = $"{task.Id}-{day:yyyyMMdd}";
                                                if (!renderedTasks.ContainsKey(taskKey))
                                                {
                                                    int startHour = task.Task_StartTime.Value.Hours;
                                                    int endHour = task.Task_EndTime.Value.Hours;
                                                    int span = Math.Max(1, endHour - startHour);
                                                    renderedTasks[taskKey] = span;

                                                    for (int i = 1; i < span; i++)
                                                    {
                                                        string skipKey = $"{day:yyyyMMdd}-{hour + i}";
                                                        remainingSpans[skipKey] = 1;
                                                    }

                                                    <td rowspan="@span" class="bg-light text-start task-cell"
                                                        data-task-id="@task.Id"
                                                        data-date="@day.ToString("yyyy-MM-dd")"
                                                        data-start-hour="@startHour"
                                                        data-end-hour="@endHour"
                                                        style="cursor: move;">
                                                        <div class="task-card h-100 w-100 shadow-sm border-start border-4 border-success p-2">
                                                            <div class="position-relative">
                                                                <div class="dropdown task-options">
                                                                    <button class="btn btn-sm btn-transparent position-absolute top-0 end-0 me-1 mt-1 p-1 border-0 shadow-none"
                                                                            type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Task options">
                                                                        <i class="bi bi-three-dots-vertical text-dark"></i>
                                                                    </button>

                                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                                        <li>
                                                                            <a class="dropdown-item text-primary" href="/Edit_TaskSchedule?id=@task.Id">
                                                                                <i class="bi bi-pencil me-1"></i>Edit
                                                                            </a>
                                                                        </li>
                                                                        <li>
                                                                            <a class="dropdown-item text-danger" href="#" onclick="deleteTask('@task.Id')">
                                                                                <i class="bi bi-trash me-1"></i>Delete
                                                                            </a>
                                                                        </li>
                                                                    </ul>
                                                                </div>

                                                                <div class="task-hover-content pe-4">
                                                                    <h6 class="mb-1">@task.Task_Name</h6>
                                                                    <p class="mb-1 small text-muted">@task.Task_Description</p>
                                                                    <div class="small text-dark">
                                                                        <span><strong>@task.Qty</strong> @task.Unit</span><br />
                                                                        <span>Machine @task.Assign_To</span><br />
                                                                        <span class="text-muted">
                                                                            @task.Task_StartTime?.ToString(@"hh\:mm") - @task.Task_EndTime?.ToString(@"hh\:mm")
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </td>
                                                }
                                            }
                                            else
                                            {
                                                <td>-</td>
                                            }
                                        }
                                        else
                                        {
                                            <td>-</td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Search filter
            $('#taskSearch').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('#taskTableBody tr').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            // Filter form triggers
            $('#startDatePicker, #machineSelector').on('change', function () {
                $('#filterForm').submit();
            });

            // Export to Excel
            $('#exportBtn').on('click', function () {
                var table = document.getElementById("taskTable");
                var workbook = XLSX.utils.table_to_book(table, { sheet: "Tasks" });
                XLSX.writeFile(workbook, "Task_Schedule.xlsx");
            });

            // Enhanced drag logic for horizontal and vertical movement
            $(".task-cell").each(function () {
                const cell = $(this);
                const content = cell.find(".task-card");
                const tableRowHeight = cell.closest("tr").height();
                const tableColWidth = cell.outerWidth();

                cell.draggable({
                    grid: [tableColWidth, tableRowHeight],
                    containment: "#taskTable",
                    stop: function (event, ui) {
                        const movedRows = Math.round(ui.position.top / tableRowHeight);
                        const movedCols = Math.round(ui.position.left / tableColWidth);

                        if (movedRows !== 0 || movedCols !== 0) {
                            updateTaskTime(cell, movedRows, 0, movedCols);
                        }
                    }
                });

                content.resizable({
                    handles: "s",
                    grid: [0, tableRowHeight],
                    stop: function (event, ui) {
                        const originalSpan = parseInt(cell.attr("rowspan")) || 1;
                        const newHeight = ui.size.height;
                        const newSpan = Math.round(newHeight / tableRowHeight);
                        const durationDiff = newSpan - originalSpan;

                        if (durationDiff !== 0) {
                            updateTaskTime(cell, 0, durationDiff, 0);
                        }
                    }
                });
            });

            function updateTaskTime(cell, hourDelta, durationDelta, dayDelta) {
                const taskId = cell.data("task-id");
                const dateStr = cell.data("date");
                const originalDate = new Date(dateStr);
                const startHour = parseInt(cell.data("start-hour")) + hourDelta;
                const endHour = parseInt(cell.data("end-hour")) + hourDelta + durationDelta;

                if (startHour < 0 || endHour > 24 || startHour >= endHour) {
                    alert("Invalid time adjustment.");
                    return;
                }

                originalDate.setDate(originalDate.getDate() + dayDelta);
                const updatedDate = originalDate.toISOString().split("T")[0];

                // New logic to calculate multi-day span
                const newEndDate = new Date(updatedDate);
                if (endHour >= 24) {
                    newEndDate.setDate(newEndDate.getDate() + Math.floor(endHour / 24));
                }
                const adjustedEndHour = endHour % 24;
                const updatedEndDate = newEndDate.toISOString().split("T")[0];

                $.ajax({
                    url: '/api/schedule/update',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        id: taskId,
                        date: updatedDate,
                        endDate: updatedEndDate,
                        startHour: startHour,
                        endHour: adjustedEndHour
                    }),
                    success: function () {
                        location.reload();
                    },
                    error: function () {
                        alert("Failed to update task schedule.");
                    }
                });
            }
        });
    </script>
}