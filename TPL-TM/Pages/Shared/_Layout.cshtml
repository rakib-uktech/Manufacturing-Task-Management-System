<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TPL_TM</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <!-- Font Awesome (Optional, for more icons) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/css/bootstrap.min.css" />

    <!-- Bootstrap and Chart.js CDN -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/css/bootstrap.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.1/chart.min.js"></script>

    <!-- jQuery and Bootstrap Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <!-- DataTables and Responsive JS -->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/photoswipe@5/dist/photoswipe.css">

    <style>
        .navbar {
            background-color: #007bff;
        }
        .navbar .navbar-nav .nav-item .nav-link {
            color: white;
        }
        .navbar .navbar-nav .nav-item .nav-link:hover {
            color: #f8f9fa;
        }

        /* Sticky top navbar */
        .navbar-top {
            position: sticky;
            top: 0;
            z-index: 1030; /* Ensure the top navbar stays on top */
        }
    </style>
    <style>
        #globalLoader {
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.85);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            #globalLoader.hide {
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.3s ease;
            }
    </style>

</head>
<body>
    <!-- Global Page Loader -->
    <div id="globalLoader">
        <div class="loader-box">
            <div class="spinner-border text-primary"></div>
            <div class="mt-3 fw-semibold">Loading, please wait…</div>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark border-bottom box-shadow mb-3 fixed-top"
             style="z-index: 1070; width: 100%; background-color: #457c30;">
            <div class="container-fluid">
                <div class="d-flex align-items-center justify-content-between w-100 flex-wrap">
                    <!-- Sidebar Toggle (visible on small only) -->
                    <button class="btn text-white d-lg-none me-2" onclick="toggleSidebar()" style="font-size: 1.5rem;">
                        <i class="bi bi-list"></i>
                    </button>

                    <!-- Logo -->
                    <a class="navbar-brand text-white flex-grow-1 me-auto me-lg-2" asp-area="" asp-page="/Index">
                        <img src="~/images/tpl wht.png" class="img-fluid" style="max-height: 30px; max-width: 220px;" alt="Logo" />
                    </a>

                    <!-- Custom Navbar toggler -->
                    <button class="navbar-toggler ms-auto" type="button" id="customNavbarToggler" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>


                <!-- Collapsible content -->
                <div class="collapse navbar-collapse justify-content-end" id="customNavbarCollapse">
                    <ul class="navbar-nav mb-2 mb-lg-0">
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid" style="padding-top: 0px;">
         @* @if (ViewData["Title"]?.ToString() == "Operator Dashboard")
         {
            <!-- Centered layout for Operator Dashboard -->
            <div class="d-flex justify-content-center align-items-start" style="min-height: 100vh; padding-top: 80px;">
                <div class="col-12 col-md-8 col-lg-6">
                    <main role="main" class="pb-3 text-center">
                        @RenderBody()
                    </main>
                </div>
            </div>
        }
        else if (ViewData["Title"]?.ToString() == "Shift Dashboard")
        {
            <!-- Centered layout for Shift Dashboard -->
            <div class="d-flex justify-content-center align-items-start" style="min-height: 100vh; padding-top: 80px;">
                <div class="col-12 col-md-8 col-lg-6">
                    <main role="main" class="pb-3 text-center">
                        @RenderBody()
                    </main>
                </div>
            </div>
        } 
        else
        { 
        }  *@
        <div class="row">
            <partial name="_Sidebar" />

            <!-- Normal Layout with Sidebar -->
            <div class="col-sm-9 offset-sm-3 col-md-10 offset-md-2">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
       
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
   
    <!-- Bootstrap Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- DataTables -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

    <!-- Custom JS to toggle login menu -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggler = document.getElementById("customNavbarToggler");
            const collapse = document.getElementById("customNavbarCollapse");

            if (toggler && collapse) {
                toggler.addEventListener("click", function () {
                    collapse.classList.toggle("show");
                });

                // Close on nav-link click (optional)
                collapse.querySelectorAll(".nav-link").forEach(link => {
                    link.addEventListener("click", () => {
                        const isDropdownToggle = link.classList.contains("dropdown-toggle");
                        if (!isDropdownToggle) {
                            collapse.classList.remove("show");
                        }
                    });
                });
            }
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const loader = document.getElementById("globalLoader");

            // Intercept navigation for all links
            document.addEventListener("click", function (e) {
                const link = e.target.closest("a.js-nav-link");
                if (!link) return;

                if (link.dataset.bsToggle) return; // ignore dropdown toggles

                e.preventDefault(); // stop instant navigation

                if (loader) loader.classList.remove("hide");

                const href = link.href;
                setTimeout(() => window.location.href = href, 60);
            });
        });

        // Hide loader on full page load
        window.addEventListener("load", function () {
            const loader = document.getElementById("globalLoader");
            if (loader) loader.classList.add("hide");
        });

        // Handle browser BFCache (back-forward cache / bookmark restore)
        window.addEventListener("pageshow", function (event) {
            const loader = document.getElementById("globalLoader");
            if (!loader) return;

            if (event.persisted) {
                loader.classList.remove("hide");
                setTimeout(() => loader.classList.add("hide"), 50);
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    
</body>
</html>
