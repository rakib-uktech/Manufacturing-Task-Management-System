@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<style>
    body {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        overflow-x: hidden;
    }

    /* Main container */
    .main-container {
        display: flex;
        height: 100%;
        min-height: auto;
    }

    /* Sidebar */
    .sidebar {
        position: fixed;
        top: 56px; /* Offset below the fixed navbar */
        left: 0;
        height: calc(100vh - 56px); /* Full height minus navbar */
        width: 250px;
        background-color: #343a40;
        color: white;
        padding-top: 20px;
        z-index: 1051;
        transition: transform 0.3s ease-in-out;
        transform: translateX(0);
        /* Make sidebar scrollable on all screen sizes */
        overflow-y: auto;
        overflow-x: auto; /* ADD THIS */
        scroll-behavior: smooth;
    }


        .sidebar.hide {
            transform: translateX(-100%);
        }

        .sidebar .nav {
            flex-wrap: nowrap;
        }


        .sidebar .nav-link {
            color: #adb5bd;
            font-size: 16px;
            padding: 10px 15px;
            white-space: nowrap; /* prevent line break */
            overflow: hidden;           
        }

            .sidebar .nav-link:hover {
                color: white;
                background-color: #495057;
                border-radius: 5px;
            }

    /* Separator */
    .nav-item:not(:last-child)::after {
        content: "";
        display: block;
        height: 1px;
        background-color: #6c757d;
        margin: 8px 0;
        width: 90%;
        margin-left: auto;
        margin-right: auto;
    }

    /* Content area */
    .content {
        flex-grow: 1;
        margin-left: 250px;
        padding: 20px;
        padding-top: 76px; /* Add space for the navbar */
        transition: margin-left 0.3s ease-in-out;
    }

    /* Mobile adjustments */
    @@media (max-width: 992px) {
        .sidebar {
            transform: translateX(-100%);
            top: 56px;
            height: calc(100vh - 56px);
            overflow-y: auto; /* Enable vertical scrolling */
            overflow-x: auto; /* ADD THIS */
        }

            .sidebar.show {
                transform: translateX(0);
            }

            .sidebar::-webkit-scrollbar {
                height: 6px;
            }

        .content {
            margin-left: 0;
            padding-top: 76px;
        }
    }

    /* Larger screens adjustments */
    @@media (min-width: 992px) {
        .sidebar {
            transform: translateX(0);
        }

        .content {
            margin-left: 250px;
        }
    }
</style>

