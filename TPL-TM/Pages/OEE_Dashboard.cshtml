<!-- ═══════════ SCRIPTS ═══════════ -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script>
    $(function () {
        const PLANNED_MINS_PER_SHIFT = 480;

        let C = {};

        function cssVar(name) {
            return getComputedStyle(document.body).getPropertyValue(name).trim();
        }

        function syncThemeColors() {
            C = {
                accent: cssVar('--accent'),
                accent2: cssVar('--accent2'),
                warn: cssVar('--warn'),
                danger: cssVar('--danger'),
                green: cssVar('--green'),
                muted: cssVar('--muted'),
                border: cssVar('--border'),
                grid: cssVar('--chart-grid'),
                gaugeTrack: cssVar('--gauge-track'),
                gaugeNeedle: cssVar('--gauge-needle'),
                heading: cssVar('--heading'),
                shifts: [cssVar('--green'), cssVar('--accent2'), cssVar('--warn')],
                reasons: [cssVar('--danger'), cssVar('--warn'), cssVar('--accent2'), cssVar('--accent'), '#8b5cf6', '#ec4899', cssVar('--muted')],
                waste: [cssVar('--warn'), cssVar('--danger'), cssVar('--accent2'), '#8b5cf6', cssVar('--green'), '#ec4899']
            };

            Chart.defaults.color = C.muted;
            Chart.defaults.font.family = "'DM Mono', monospace";
            Chart.defaults.font.size = 10;
        }

        const savedTheme = localStorage.getItem('oee-theme') || 'light';
        $('body').toggleClass('night-mode', savedTheme === 'night');
        $('#nightModeToggle').prop('checked', savedTheme === 'night');
        syncThemeColors();

        const charts = {};

        function safeChart(id, cfg) {
            if (charts[id]) charts[id].destroy();

            const el = document.getElementById(id);
            if (!el) return;

            charts[id] = new Chart(el, cfg);
        }

        function getFilters() {
            return {
                search: $('#search').val(),
                range: $('#range').val(),
                fromDate: $('#fromDate').val(),
                toDate: $('#toDate').val(),
                machineLine: $('#machineLine').val()
            };
        }

        function debounce(fn, d = 400) {
            let t;
            return () => {
                clearTimeout(t);
                t = setTimeout(fn, d);
            };
        }

        function oeeColor(v) {
            return v >= 85 ? C.green : v >= 65 ? C.warn : C.danger;
        }

        function oeeClass(v) {
            return v >= 85 ? 'oee-good' : v >= 65 ? 'oee-ok' : 'oee-bad';
        }

        function pillClass(v) {
            return v >= 85 ? 'pill-good' : v >= 65 ? 'pill-ok' : 'pill-bad';
        }

        function pillText(v) {
            return v >= 85 ? 'ON TARGET' : v >= 65 ? 'WARNING' : 'CRITICAL';
        }

        function enc(s) {
            const d = document.createElement('div');
            d.textContent = s || '';
            return d.innerHTML;
        }

        function calcOEE(item) {
            const shifts = new Set();

            (item.data || []).forEach(r => {
                if (r.shift) shifts.add(r.shift);
            });

            const shiftCount = Math.max(shifts.size, 1);
            const plannedMins = shiftCount * PLANNED_MINS_PER_SHIFT;

            const avail = plannedMins > 0
                ? Math.max(0, Math.min(100, Math.round((plannedMins - (item.downtime || 0)) / plannedMins * 100)))
                : 100;

            const perf = item.target > 0
                ? Math.max(0, Math.min(100, Math.round(item.total / item.target * 100)))
                : 0;

            const wasteUnits = item.waste > 0 ? Math.round(item.waste / 0.2) : 0;

            const qual = item.total > 0
                ? Math.max(50, Math.min(100, Math.round((item.total - wasteUnits) / item.total * 100)))
                : 100;

            const oee = Math.round(avail * perf * qual / 10000);

            return { oee, avail, perf, qual, plannedMins, shiftCount };
        }

        function drawGauge(id, pct, color) {
            const canvas = document.getElementById(id);
            if (!canvas) return;

            const dpr = window.devicePixelRatio || 1;
            const W = canvas.clientWidth || 130;
            const H = canvas.clientHeight || 75;

            canvas.width = W * dpr;
            canvas.height = H * dpr;

            const ctx = canvas.getContext('2d');
            ctx.scale(dpr, dpr);

            const cx = W / 2;
            const cy = H - 4;
            const r = Math.min(cx, cy) - 9;

            ctx.beginPath();
            ctx.arc(cx, cy, r, Math.PI, 0);
            ctx.strokeStyle = C.gaugeTrack;
            ctx.lineWidth = 10;
            ctx.lineCap = 'butt';
            ctx.stroke();

            const end = Math.PI + Math.PI * Math.min(pct, 100) / 100;
            ctx.beginPath();
            ctx.arc(cx, cy, r, Math.PI, end);
            ctx.strokeStyle = color;
            ctx.lineWidth = 10;
            ctx.lineCap = 'round';
            ctx.stroke();

            [25, 50, 75, 85].forEach(v => {
                const a = Math.PI + Math.PI * v / 100;
                const r1 = r + 5;
                const r2 = r - 2;

                ctx.beginPath();
                ctx.moveTo(cx + Math.cos(a) * r1, cy + Math.sin(a) * r1);
                ctx.lineTo(cx + Math.cos(a) * r2, cy + Math.sin(a) * r2);
                ctx.strokeStyle = v === 85 ? C.green : C.gaugeTrack;
                ctx.lineWidth = v === 85 ? 1.5 : 0.8;
                ctx.stroke();
            });

            const na = Math.PI + Math.PI * Math.min(pct, 100) / 100;

            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.lineTo(cx + Math.cos(na) * (r - 5), cy + Math.sin(na) * (r - 5));
            ctx.strokeStyle = C.gaugeNeedle;
            ctx.lineWidth = 1.5;
            ctx.lineCap = 'round';
            ctx.stroke();

            ctx.beginPath();
            ctx.arc(cx, cy, 3, 0, Math.PI * 2);
            ctx.fillStyle = C.gaugeNeedle;
            ctx.fill();
        }

        function loadDashboard() {
            syncThemeColors();

            $.get('/Management_Dashboard?handler=DashboardData', getFilters(), function (data) {
                let totalOut = 0;
                let totalTarget = 0;
                let totalDown = 0;
                let totalWaste = 0;
                let allReasons = {};
                let allWasteTypes = {};
                let leagueRows = [];

                const existingLines = new Set($('#machineLine option').map((_, o) => o.value).get().filter(v => v));

                data.forEach(x => {
                    if (!existingLines.has(x.machine_Line)) {
                        $('#machineLine').append(`<option value="${enc(x.machine_Line)}">${enc(x.machine_Line)}</option>`);
                        existingLines.add(x.machine_Line);
                    }
                });

                const byLine = {};

                data.forEach(x => {
                    if (!byLine[x.machine_Line]) byLine[x.machine_Line] = [];

                    byLine[x.machine_Line].push(x);
                    totalOut += x.total;
                    totalTarget += x.target;
                    totalDown += x.downtime || 0;
                    totalWaste += x.waste || 0;

                    (x.downtimeData || []).forEach(d => {
                        const r = d.reason_Name || 'Unknown';
                        allReasons[r] = (allReasons[r] || 0) + (d.total_Downtime || 0);
                    });

                    (x.wasteData || []).forEach(w => {
                        const t = w.wasteType || 'Unknown';
                        allWasteTypes[t] = (allWasteTypes[t] || 0) + (w.wasteWeight || 0);
                    });
                });

                const shiftCount = Math.max(data.reduce((s, x) => {
                    (x.data || []).forEach(r => s.add(r.shift));
                    return s;
                }, new Set()).size, 1);

                const plantPlanned = shiftCount * PLANNED_MINS_PER_SHIFT;
                const plantAvail = Math.max(0, Math.min(100, Math.round((plantPlanned - totalDown) / plantPlanned * 100)));
                const plantPerf = totalTarget > 0 ? Math.min(100, Math.round(totalOut / totalTarget * 100)) : 0;
                const plantWasteU = totalWaste > 0 ? Math.round(totalWaste / 0.2) : 0;
                const plantQual = totalOut > 0 ? Math.max(50, Math.min(100, Math.round((totalOut - plantWasteU) / totalOut * 100))) : 100;
                const plantOEE = Math.round(plantAvail * plantPerf * plantQual / 10000);

                const oeeCol = oeeColor(plantOEE);

                $('#heroOEE').text(plantOEE + '%').css('color', oeeCol);
                $('#heroOEEsub').text(plantOEE >= 85 ? 'World class performance' : plantOEE >= 65 ? 'Room for improvement' : 'Critical — needs attention');

                $('#pillarA').text(plantAvail + '%').css('color', oeeColor(plantAvail));
                $('#pillarAbar').css({ width: plantAvail + '%', background: oeeColor(plantAvail) });
                $('#pillarAdesc').text(`${totalDown} min downtime`);

                $('#pillarP').text(plantPerf + '%').css('color', oeeColor(plantPerf));
                $('#pillarPbar').css({ width: plantPerf + '%', background: oeeColor(plantPerf) });
                $('#pillarPdesc').text(`${totalOut.toLocaleString()} / ${totalTarget.toLocaleString()}`);

                $('#pillarQ').text(plantQual + '%').css('color', oeeColor(plantQual));
                $('#pillarQbar').css({ width: plantQual + '%', background: oeeColor(plantQual) });
                $('#pillarQdesc').text(`~${plantWasteU.toLocaleString()} waste units est.`);

                const achPct = totalTarget > 0 ? Math.round(totalOut / totalTarget * 100) : 0;

                $('#kpiOutput').text(totalOut.toLocaleString());
                $('#kpiAch').text(achPct + '%').css('color', oeeColor(achPct));
                $('#kpiDown').text(totalDown.toLocaleString() + ' min');
                $('#kpiWaste').text(totalWaste.toLocaleString() + ' kg');

                const container = $('#dashboardContainer').empty();
                let belowOEE = 0;

                Object.keys(byLine).sort().forEach(line => {
                    const items = byLine[line];
                    const lineOut = items.reduce((s, x) => s + x.total, 0);
                    const lineTgt = items.reduce((s, x) => s + x.target, 0);
                    const lineDown = items.reduce((s, x) => s + (x.downtime || 0), 0);
                    const lineAch = lineTgt > 0 ? Math.round(lineOut / lineTgt * 100) : 0;

                    const section = $(`
                        <div class="line-section">
                            <div class="line-header">
                                <span class="line-tag">${enc(line)}</span>
                                <span class="line-stats">${items.length} machine(s) &nbsp;·&nbsp; ${lineOut.toLocaleString()} units &nbsp;·&nbsp; ${lineAch}% ach. &nbsp;·&nbsp; ${lineDown} min DT</span>
                            </div>
                            <div class="machines-grid" id="grid_${line.replace(/\W/g, '_')}"></div>
                        </div>
                    `);

                    container.append(section);
                    const grid = section.find('.machines-grid');

                    items.sort((a, b) => b.achievement - a.achievement).forEach((item, idx) => {
                        const id = (line + item.machine_name + item.product_Line + idx).replace(/\W/g, '');
                        const oeeData = calcOEE(item);

                        if (oeeData.oee < 85) belowOEE++;

                        const shiftSum = { A: 0, B: 0, C: 0 };

                        (item.data || []).forEach(r => {
                            shiftSum[r.shift] = (shiftSum[r.shift] || 0) + r.product_Count;
                        });

                        const reasons = {};

                        (item.downtimeData || []).forEach(d => {
                            const r = d.reason_Name || 'Unknown';
                            reasons[r] = (reasons[r] || 0) + (d.total_Downtime || 0);
                        });

                        const reasonKeys = Object.keys(reasons).sort((a, b) => reasons[b] - reasons[a]).slice(0, 4);
                        const reasonMax = Math.max(...Object.values(reasons), 1);
                        const oc = oeeColor(oeeData.oee);

                        leagueRows.push({
                            name: item.machine_name,
                            line: item.machine_Line,
                            oee: oeeData.oee,
                            avail: oeeData.avail,
                            perf: oeeData.perf,
                            qual: oeeData.qual,
                            downtime: item.downtime || 0
                        });

                        const card = $(`
                            <div class="mcard ${oeeClass(oeeData.oee)}">
                                <div class="mcard-head">
                                    <div>
                                        <div class="mcard-title">${enc(item.machine_name)}</div>
                                        <div class="mcard-sub">${enc(item.machine_Line)} &nbsp;·&nbsp; ${enc(item.product_Line)}</div>
                                    </div>
                                    <span class="status-pill ${pillClass(oeeData.oee)}">${pillText(oeeData.oee)}</span>
                                </div>

                                <div class="oee-breakdown">
                                    <div class="oee-cell">
                                        <div class="oee-cell-label">OEE</div>
                                        <div class="oee-cell-value" style="color:${oc};">${oeeData.oee}%</div>
                                        <div class="oee-cell-bar"><div class="oee-cell-fill" style="width:${oeeData.oee}%;background:${oc};"></div></div>
                                    </div>
                                    <div class="oee-cell">
                                        <div class="oee-cell-label">Avail.</div>
                                        <div class="oee-cell-value" style="color:${oeeColor(oeeData.avail)};">${oeeData.avail}%</div>
                                        <div class="oee-cell-bar"><div class="oee-cell-fill" style="width:${oeeData.avail}%;background:${oeeColor(oeeData.avail)};"></div></div>
                                    </div>
                                    <div class="oee-cell">
                                        <div class="oee-cell-label">Perf.</div>
                                        <div class="oee-cell-value" style="color:${oeeColor(oeeData.perf)};">${oeeData.perf}%</div>
                                        <div class="oee-cell-bar"><div class="oee-cell-fill" style="width:${oeeData.perf}%;background:${oeeColor(oeeData.perf)};"></div></div>
                                    </div>
                                    <div class="oee-cell">
                                        <div class="oee-cell-label">Qual.</div>
                                        <div class="oee-cell-value" style="color:${oeeColor(oeeData.qual)};">${oeeData.qual}%</div>
                                        <div class="oee-cell-bar"><div class="oee-cell-fill" style="width:${oeeData.qual}%;background:${oeeColor(oeeData.qual)};"></div></div>
                                    </div>
                                </div>

                                <div style="display:grid;grid-template-columns:130px 1fr;gap:0;border-bottom:1px solid var(--border);">
                                    <div style="padding:10px 12px;border-right:1px solid var(--border);display:flex;flex-direction:column;align-items:center;justify-content:center;">
                                        <div style="position:relative;width:120px;height:70px;">
                                            <canvas id="gauge_${id}" width="120" height="70" style="width:120px;height:70px;display:block;"></canvas>
                                            <div style="position:absolute;bottom:4px;left:0;right:0;text-align:center;pointer-events:none;">
                                                <span style="font-family:'Syne',sans-serif;font-size:14px;font-weight:800;color:${oc};">${oeeData.oee}%</span><br>
                                                <span style="font-size:9px;color:var(--muted);letter-spacing:1px;">OEE</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mcard-metrics" style="border:none;">
                                        <div class="metric-cell">
                                            <div class="metric-label">Output</div>
                                            <div class="metric-value ${item.achievement >= 90 ? 'c-accent' : item.achievement >= 70 ? 'c-warn' : 'c-danger'}">${item.total.toLocaleString()}</div>
                                        </div>
                                        <div class="metric-cell">
                                            <div class="metric-label">Target</div>
                                            <div class="metric-value">${item.target.toLocaleString()}</div>
                                        </div>
                                        <div class="metric-cell">
                                            <div class="metric-label">Downtime</div>
                                            <div class="metric-value ${(item.downtime || 0) > 60 ? 'c-danger' : 'c-warn'}">${(item.downtime || 0)} min</div>
                                        </div>
                                        <div class="metric-cell">
                                            <div class="metric-label">Waste</div>
                                            <div class="metric-value c-warn">${(item.waste || 0).toFixed(1)} kg</div>
                                        </div>
                                        <div class="metric-cell">
                                            <div class="metric-label">Planned</div>
                                            <div class="metric-value">${oeeData.plannedMins} min</div>
                                        </div>
                                        <div class="metric-cell">
                                            <div class="metric-label">Shifts</div>
                                            <div class="metric-value">${oeeData.shiftCount}</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="shift-row">
                                    <div class="shift-chip chip-a">Shift A<br><strong>${shiftSum.A.toLocaleString()}</strong></div>
                                    <div class="shift-chip chip-b">Shift B<br><strong>${shiftSum.B.toLocaleString()}</strong></div>
                                    <div class="shift-chip chip-c">Shift C<br><strong>${shiftSum.C.toLocaleString()}</strong></div>
                                </div>

                                ${reasonKeys.length ? `
                                    <div class="dt-list">
                                        <div style="font-size:9px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin-bottom:7px;">Downtime Reasons</div>
                                        ${reasonKeys.map((r, i) => `
                                            <div class="dt-item">
                                                <div class="dt-name" title="${enc(r)}">${enc(r)}</div>
                                                <div class="dt-track"><div class="dt-fill" style="width:${Math.round(reasons[r] / reasonMax * 100)}%;background:${C.reasons[i % C.reasons.length]};"></div></div>
                                                <div class="dt-min">${reasons[r]}m</div>
                                            </div>
                                        `).join('')}
                                    </div>
                                ` : ''}

                                <div class="mcard-charts">
                                    <div class="chart-cell">
                                        <div class="chart-cell-label">7-day output</div>
                                        <div style="position:relative;height:70px;"><canvas id="line_${id}"></canvas></div>
                                    </div>
                                    <div class="chart-cell">
                                        <div class="chart-cell-label">Downtime split</div>
                                        <div style="position:relative;height:70px;"><canvas id="dt_${id}"></canvas></div>
                                    </div>
                                </div>
                            </div>
                        `);

                        grid.append(card);

                        setTimeout(() => drawGauge(`gauge_${id}`, oeeData.oee, oc), 30);

                        const rows = item.data || [];
                        const dayLabels = [];
                        const dayData = [];

                        for (let i = 6; i >= 0; i--) {
                            const d = new Date();
                            d.setDate(d.getDate() - i);
                            dayLabels.push((d.getMonth() + 1) + '/' + d.getDate());
                            dayData.push(rows.filter(r => new Date(r.timestamp_Start).toDateString() === d.toDateString()).reduce((s, r) => s + r.product_Count, 0));
                        }

                        setTimeout(() => {
                            safeChart(`line_${id}`, {
                                type: 'line',
                                data: {
                                    labels: dayLabels,
                                    datasets: [{
                                        data: dayData,
                                        fill: true,
                                        tension: .4,
                                        borderColor: oc,
                                        backgroundColor: oc + '22',
                                        borderWidth: 1.5,
                                        pointRadius: 1.5,
                                        pointBackgroundColor: oc
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: false,
                                    plugins: { legend: { display: false } },
                                    scales: {
                                        x: { ticks: { font: { size: 8 }, color: C.muted }, grid: { color: C.grid } },
                                        y: { beginAtZero: true, ticks: { font: { size: 8 }, color: C.muted }, grid: { color: C.grid } }
                                    }
                                }
                            });
                        }, 60);

                        const sdA = (item.downtimeData || []).filter(d => d.shift === 'A').reduce((s, d) => s + (d.total_Downtime || 0), 0);
                        const sdB = (item.downtimeData || []).filter(d => d.shift === 'B').reduce((s, d) => s + (d.total_Downtime || 0), 0);
                        const sdC = (item.downtimeData || []).filter(d => d.shift === 'C').reduce((s, d) => s + (d.total_Downtime || 0), 0);

                        setTimeout(() => {
                            safeChart(`dt_${id}`, {
                                type: 'doughnut',
                                data: {
                                    labels: ['A', 'B', 'C'],
                                    datasets: [{
                                        data: [sdA, sdB, sdC],
                                        backgroundColor: C.shifts,
                                        borderWidth: 0,
                                        hoverOffset: 3
                                    }]
                                },
                                options: {
                                    cutout: '68%',
                                    responsive: true,
                                    maintainAspectRatio: false,
                                    plugins: {
                                        legend: {
                                            display: true,
                                            position: 'right',
                                            labels: {
                                                font: { size: 9 },
                                                color: C.muted,
                                                padding: 6,
                                                boxWidth: 8
                                            }
                                        }
                                    }
                                }
                            });
                        }, 90);
                    });
                });

                $('#kpiBelowOEE').text(belowOEE);
                $('#kpiBelowSub').text(belowOEE === 0 ? 'All on target' : 'machine(s) below 85% OEE');

                leagueRows.sort((a, b) => b.oee - a.oee);

                const lb = $('#leagueBody').empty();

                leagueRows.forEach((r, i) => {
                    const oc = oeeColor(r.oee);

                    lb.append(`
                        <tr>
                            <td><span class="rank-num">${i + 1}</span></td>
                            <td>
                                <div style="font-weight:600;color:var(--heading);">${enc(r.name)}</div>
                                <div style="font-size:9px;color:var(--muted);">${enc(r.line)}</div>
                            </td>
                            <td><span class="oee-badge" style="color:${oc};">${r.oee}%</span></td>
                            <td style="color:${oeeColor(r.avail)};">${r.avail}%</td>
                            <td style="color:${oeeColor(r.perf)};">${r.perf}%</td>
                            <td style="color:${oeeColor(r.qual)};">${r.qual}%</td>
                            <td style="color:var(--danger);">${r.downtime} min</td>
                        </tr>
                    `);
                });

                const trendLabels = [];
                const trendActual = [];
                const trendTarget = [];

                for (let i = 6; i >= 0; i--) {
                    const d = new Date();
                    d.setDate(d.getDate() - i);
                    trendLabels.push((d.getMonth() + 1) + '/' + d.getDate());

                    let da = 0;
                    let dt2 = 0;

                    data.forEach(x => {
                        (x.data || []).forEach(r => {
                            if (new Date(r.timestamp_Start).toDateString() === d.toDateString()) da += r.product_Count;
                        });

                        if (new Date().toDateString() === d.toDateString()) dt2 += x.target;
                    });

                    trendActual.push(da);
                    trendTarget.push(dt2);
                }

                setTimeout(() => {
                    safeChart('globalTrendChart', {
                        type: 'line',
                        data: {
                            labels: trendLabels,
                            datasets: [
                                {
                                    label: 'Actual',
                                    data: trendActual,
                                    fill: true,
                                    tension: .4,
                                    borderColor: C.accent,
                                    backgroundColor: C.accent + '18',
                                    borderWidth: 2,
                                    pointRadius: 3,
                                    pointBackgroundColor: C.accent
                                },
                                {
                                    label: 'Target',
                                    data: trendTarget,
                                    fill: false,
                                    tension: 0,
                                    borderColor: C.muted,
                                    borderDash: [4, 3],
                                    borderWidth: 1.5,
                                    pointRadius: 0
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    labels: {
                                        color: C.muted,
                                        font: { size: 10 },
                                        boxWidth: 10
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    ticks: { font: { size: 10 }, color: C.muted },
                                    grid: { color: C.grid }
                                },
                                y: {
                                    beginAtZero: false,
                                    ticks: {
                                        font: { size: 10 },
                                        color: C.muted,
                                        callback: v => v >= 1000 ? (v / 1000).toFixed(1) + 'k' : v
                                    },
                                    grid: { color: C.grid }
                                }
                            }
                        }
                    });
                }, 200);

                const dtKeys = Object.keys(allReasons).sort((a, b) => allReasons[b] - allReasons[a]).slice(0, 8);
                const dtVals = dtKeys.map(k => allReasons[k]);

                setTimeout(() => {
                    if (!dtKeys.length) return;

                    safeChart('globalDtChart', {
                        type: 'bar',
                        data: {
                            labels: dtKeys,
                            datasets: [{
                                data: dtVals,
                                backgroundColor: dtKeys.map((_, i) => C.reasons[i % C.reasons.length]),
                                borderRadius: 4,
                                barThickness: 22
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: { callbacks: { label: ctx => `${ctx.raw} min` } }
                            },
                            scales: {
                                x: {
                                    ticks: {
                                        font: { size: 9 },
                                        color: C.muted,
                                        maxRotation: 35,
                                        autoSkip: false
                                    },
                                    grid: { display: false }
                                },
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        font: { size: 9 },
                                        color: C.muted,
                                        callback: v => v + 'm'
                                    },
                                    grid: { color: C.grid }
                                }
                            }
                        }
                    });
                }, 220);

                const wKeys = Object.keys(allWasteTypes).sort((a, b) => allWasteTypes[b] - allWasteTypes[a]);
                const wVals = wKeys.map(k => allWasteTypes[k]);

                setTimeout(() => {
                    if (!wKeys.length) return;

                    safeChart('globalWasteChart', {
                        type: 'doughnut',
                        data: {
                            labels: wKeys,
                            datasets: [{
                                data: wVals,
                                backgroundColor: wKeys.map((_, i) => C.waste[i % C.waste.length]),
                                borderWidth: 0,
                                hoverOffset: 6
                            }]
                        },
                        options: {
                            cutout: '60%',
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'right',
                                    labels: {
                                        color: C.muted,
                                        font: { size: 10 },
                                        padding: 10,
                                        boxWidth: 10
                                    }
                                },
                                tooltip: {
                                    callbacks: {
                                        label: ctx => `${ctx.raw.toFixed(1)} kg`
                                    }
                                }
                            }
                        }
                    });
                }, 240);
            });
        }

        document.getElementById('nowTs').textContent =
            new Date().toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' });

        $('#nightModeToggle').change(function () {
            const night = this.checked;
            $('body').toggleClass('night-mode', night);
            localStorage.setItem('oee-theme', night ? 'night' : 'light');
            syncThemeColors();
            loadDashboard();
        });

        $('#range').change(function () {
            const custom = this.value === 'custom';
            $('#fromDate,#toDate,#applyBtn').prop('disabled', !custom);
            if (!custom) loadDashboard();
        });

        $('#applyBtn').click(loadDashboard);
        $('#search').on('keyup', debounce(loadDashboard));
        $('#machineLine').change(loadDashboard);
        $('#refreshBtn').click(loadDashboard);

        function showAI(txt) {
            $('#aiReportText').text(txt);
            $('#aiReportContainer').show();
        }

        $('#aiReportBtn').click(() => {
            showAI('Generating GPT-4o report…');
            $.get('/Management_Dashboard?handler=AIReport', getFilters(), showAI).fail(e => showAI('❌ ' + e.responseText));
        });

        $('#claudeReportBtn').click(() => {
            showAI('Generating Claude report…');
            $.get('/Management_Dashboard?handler=ClaudeReport', getFilters(), showAI).fail(e => showAI('❌ ' + e.responseText));
        });

        $('#sendEmailBtn').click(() => {
            showAI('Sending report email…');
            $.get('/Management_Dashboard?handler=SendAIEmail', getFilters(), showAI).fail(() => showAI('❌ Email send failed'));
        });

        $('#exportBtn').click(() => {
            $.get('/Management_Dashboard?handler=DashboardData', getFilters(), function (data) {
                const csv = ['Machine,Line,Product,OEE%,Avail%,Perf%,Qual%,Output,Target,Ach%,Downtime(min),Waste(kg)'];

                data.forEach(x => {
                    const o = calcOEE(x);
                    csv.push([x.machine_name, x.machine_Line, x.product_Line, o.oee, o.avail, o.perf, o.qual, x.total, x.target, x.achievement, x.downtime || 0, (x.waste || 0).toFixed(1)].join(','));
                });

                const a = document.createElement('a');
                a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv.join('\n'));
                a.download = 'OEE_Report_' + new Date().toISOString().slice(0, 10) + '.csv';
                a.click();
            });
        });

        let autoTimer;

        function startAuto() {
            clearInterval(autoTimer);
            if ($('#autoRefresh').is(':checked')) autoTimer = setInterval(loadDashboard, 30000);
        }

        $('#autoRefresh').change(startAuto);

        loadDashboard();
        startAuto();
    });
</script>