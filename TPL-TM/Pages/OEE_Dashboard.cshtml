@page
@model TPL_TM.Pages.OEE_DashboardModel

<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --bg: #f5f7fb;
        --surface: #ffffff;
        --surface2: #eef2f7;
        --border: rgba(15,23,42,0.10);
        --border2: rgba(15,23,42,0.18);
        --text: #0f172a;
        --heading: #0f172a;
        --card-text: #1e293b;
        --muted: #475569;
        --accent: #00a889;
        --accent2: #0284c7;
        --warn: #d97706;
        --danger: #dc2626;
        --green: #16a34a;
        --oee-good: #00a889;
        --oee-ok: #d97706;
        --oee-bad: #dc2626;
        --chart-grid: rgba(15,23,42,0.08);
        --gauge-track: rgba(15,23,42,0.10);
        --gauge-needle: rgba(15,23,42,0.70);
        --ghost-text: rgba(15,23,42,0.04);
        --shadow: rgba(15,23,42,0.12);
        --font-head: 'Syne', sans-serif;
        --font-mono: 'DM Mono', monospace;
    }

    body.night-mode {
        --bg: #0a0d12;
        --surface: #111620;
        --surface2: #171d2a;
        --border: rgba(255,255,255,0.07);
        --border2: rgba(255,255,255,0.12);
        --text: #e2e8f0;
        --heading: #ffffff;
        --card-text: #cbd5e1;
        --muted: #94a3b8;
        --accent: #00d4aa;
        --accent2: #0ea5e9;
        --warn: #f59e0b;
        --danger: #ef4444;
        --green: #22c55e;
        --oee-good: #00d4aa;
        --oee-ok: #f59e0b;
        --oee-bad: #ef4444;
        --chart-grid: rgba(255,255,255,0.04);
        --gauge-track: rgba(255,255,255,0.08);
        --gauge-needle: rgba(255,255,255,0.75);
        --ghost-text: rgba(255,255,255,0.02);
        --shadow: rgba(0,0,0,0.40);
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-mono);
        font-size: 13px;
        min-height: 100vh;
        transition: background .2s ease, color .2s ease;
    }

    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 24px;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        gap: 16px;
        flex-wrap: wrap;
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .topbar-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .brand-mark {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, var(--accent), var(--accent2));
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        color: #000;
    }

    .brand-title {
        font-family: var(--font-head);
        font-size: 18px;
        font-weight: 800;
        color: var(--heading);
        letter-spacing: -0.3px;
    }

    .brand-sub {
        font-size: 10px;
        color: var(--muted);
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-top: 1px;
    }

    .live-pill {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(0,168,137,0.10);
        border: 1px solid rgba(0,168,137,0.28);
        border-radius: 20px;
        padding: 3px 10px;
        font-size: 10px;
        color: var(--accent);
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .live-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
        animation: blink 2s infinite;
    }

    .theme-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 10px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .switch {
        position: relative;
        width: 42px;
        height: 22px;
        flex: 0 0 auto;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        inset: 0;
        background: var(--surface2);
        border: 1px solid var(--border2);
        border-radius: 22px;
        cursor: pointer;
        transition: .2s;
    }

        .slider::before {
            content: "";
            position: absolute;
            width: 16px;
            height: 16px;
            left: 3px;
            top: 2px;
            background: var(--muted);
            border-radius: 50%;
            transition: .2s;
        }

    .switch input:checked + .slider {
        background: rgba(0,212,170,0.18);
        border-color: rgba(0,212,170,0.45);
    }

        .switch input:checked + .slider::before {
            transform: translateX(19px);
            background: var(--accent);
        }

    @@keyframes blink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .2;
        }
    }

    .topbar-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        padding: 6px 14px;
        border-radius: 6px;
        border: 1px solid var(--border2);
        background: var(--surface2);
        color: var(--text);
        cursor: pointer;
        transition: all .15s;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

        .btn:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

    .btn-accent {
        background: var(--accent);
        color: #000;
        border-color: var(--accent);
        font-weight: 700;
    }

        .btn-accent:hover {
            filter: brightness(1.08);
            color: #000;
        }

    .btn-danger {
        background: rgba(220,38,38,0.12);
        border-color: rgba(220,38,38,0.35);
        color: var(--danger);
    }

    body.night-mode .btn-danger {
        background: rgba(239,68,68,0.15);
        border-color: rgba(239,68,68,0.4);
        color: #fca5a5;
    }

    .btn-danger:hover {
        background: rgba(220,38,38,0.18);
    }

    .filters-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 24px;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        flex-wrap: wrap;
    }

    .filter-label {
        font-size: 10px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .filter-control {
        font-family: var(--font-mono);
        font-size: 12px;
        height: 32px;
        padding: 0 10px;
        background: var(--surface2);
        border: 1px solid var(--border2);
        border-radius: 6px;
        color: var(--text);
        outline: none;
        transition: border-color .15s;
    }

        .filter-control:focus {
            border-color: var(--accent);
        }

        .filter-control option {
            background: var(--surface2);
            color: var(--text);
        }

        .filter-control::placeholder {
            color: var(--muted);
        }

    .filter-sep {
        width: 1px;
        height: 22px;
        background: var(--border);
        margin: 0 4px;
    }

    .main {
        padding: 20px 24px;
        max-width: 1600px;
        margin: 0 auto;
    }

    .section-label {
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .section-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }

    .oee-hero {
        display: grid;
        grid-template-columns: 220px 1fr 1fr 1fr 1fr;
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 20px;
    }

    .oee-main {
        background: var(--surface);
        padding: 24px 28px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

        .oee-main::before {
            content: 'OEE';
            position: absolute;
            right: -10px;
            bottom: -20px;
            font-family: var(--font-head);
            font-size: 80px;
            font-weight: 800;
            color: var(--ghost-text);
            pointer-events: none;
        }

    .oee-main-label,
    .pillar-label,
    .kpi-label,
    .oee-cell-label,
    .metric-label,
    .chart-cell-label {
        color: var(--muted);
    }

    .oee-main-label {
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .oee-main-value {
        font-family: var(--font-head);
        font-size: 52px;
        font-weight: 800;
        line-height: 1;
        color: var(--accent);
    }

    .oee-main-sub,
    .pillar-desc,
    .kpi-delta,
    .mcard-sub,
    .line-stats,
    .dt-name,
    .ai-sub {
        color: var(--muted);
    }

    .oee-main-sub {
        font-size: 10px;
        margin-top: 6px;
    }

    .oee-pillar {
        background: var(--surface);
        padding: 20px 20px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .pillar-label {
        font-size: 10px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .pillar-value {
        font-family: var(--font-head);
        font-size: 28px;
        font-weight: 700;
        line-height: 1;
        color: var(--heading);
    }

    .pillar-bar {
        height: 3px;
        background: var(--border);
        border-radius: 2px;
        margin-top: 10px;
        overflow: hidden;
    }

    .pillar-fill {
        height: 100%;
        border-radius: 2px;
        transition: width .6s ease;
    }

    .pillar-desc {
        font-size: 10px;
        margin-top: 5px;
    }

    .kpi-row {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 10px;
        margin-bottom: 20px;
    }

    .kpi-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 16px 18px;
        position: relative;
        overflow: hidden;
        transition: border-color .2s;
    }

        .kpi-card:hover {
            border-color: var(--border2);
        }

    .kpi-card-accent {
        border-left: 3px solid var(--accent);
    }

    .kpi-card-warn {
        border-left: 3px solid var(--warn);
    }

    .kpi-card-danger {
        border-left: 3px solid var(--danger);
    }

    .kpi-card-blue {
        border-left: 3px solid var(--accent2);
    }

    .kpi-label {
        font-size: 10px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .kpi-value {
        font-family: var(--font-head);
        font-size: 26px;
        font-weight: 700;
        color: var(--heading);
        line-height: 1;
    }

    .kpi-delta {
        font-size: 10px;
        margin-top: 5px;
    }

    .line-section {
        margin-bottom: 28px;
    }

    .line-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
    }

    .line-tag {
        font-family: var(--font-head);
        font-size: 13px;
        font-weight: 700;
        color: var(--accent);
        background: rgba(0,168,137,0.10);
        border: 1px solid rgba(0,168,137,0.24);
        padding: 3px 12px;
        border-radius: 4px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .line-stats {
        font-size: 11px;
    }

    .machines-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
        gap: 12px;
    }

    .mcard {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        transition: border-color .2s, box-shadow .2s;
    }

        .mcard:hover {
            border-color: var(--border2);
            box-shadow: 0 8px 32px var(--shadow);
        }

        .mcard.oee-good {
            border-top: 2px solid var(--oee-good);
        }

        .mcard.oee-ok {
            border-top: 2px solid var(--oee-ok);
        }

        .mcard.oee-bad {
            border-top: 2px solid var(--oee-bad);
        }

    .mcard-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 14px 16px 10px;
        border-bottom: 1px solid var(--border);
    }

    .mcard-title {
        font-family: var(--font-head);
        font-size: 14px;
        font-weight: 700;
        color: var(--heading);
    }

    .mcard-sub {
        font-size: 10px;
        margin-top: 2px;
        letter-spacing: 0.5px;
    }

    .status-pill {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 20px;
    }

    .pill-good {
        background: rgba(22,163,74,.12);
        color: #15803d;
        border: 1px solid rgba(22,163,74,.25);
    }

    .pill-ok {
        background: rgba(217,119,6,.12);
        color: #b45309;
        border: 1px solid rgba(217,119,6,.25);
    }

    .pill-bad {
        background: rgba(220,38,38,.12);
        color: #b91c1c;
        border: 1px solid rgba(220,38,38,.25);
    }

    body.night-mode .pill-good {
        color: #86efac;
    }

    body.night-mode .pill-ok {
        color: #fcd34d;
    }

    body.night-mode .pill-bad {
        color: #fca5a5;
    }

    .oee-breakdown {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        border-bottom: 1px solid var(--border);
    }

    .oee-cell {
        padding: 10px 12px;
        border-right: 1px solid var(--border);
        text-align: center;
    }

        .oee-cell:last-child {
            border-right: none;
        }

    .oee-cell-label {
        font-size: 9px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .oee-cell-value {
        font-family: var(--font-head);
        font-size: 18px;
        font-weight: 700;
        line-height: 1;
    }

    .oee-cell-bar {
        height: 2px;
        background: var(--border);
        border-radius: 1px;
        margin-top: 5px;
        overflow: hidden;
    }

    .oee-cell-fill {
        height: 100%;
        border-radius: 1px;
    }

    .mcard-metrics {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        border-bottom: 1px solid var(--border);
    }

    .metric-cell {
        padding: 10px 14px;
        border-right: 1px solid var(--border);
    }

        .metric-cell:last-child {
            border-right: none;
        }

    .metric-label {
        font-size: 9px;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .metric-value {
        font-family: var(--font-head);
        font-size: 16px;
        font-weight: 700;
        color: var(--heading);
    }

        .metric-value.c-green {
            color: var(--green);
        }

        .metric-value.c-warn {
            color: var(--warn);
        }

        .metric-value.c-danger {
            color: var(--danger);
        }

        .metric-value.c-accent {
            color: var(--accent);
        }

    .shift-row {
        display: flex;
        gap: 6px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--border);
    }

    .shift-chip {
        flex: 1;
        text-align: center;
        padding: 5px 4px;
        border-radius: 5px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .chip-a {
        background: rgba(22,163,74,.12);
        color: #15803d;
        border: 1px solid rgba(22,163,74,.22);
    }

    .chip-b {
        background: rgba(2,132,199,.12);
        color: #0369a1;
        border: 1px solid rgba(2,132,199,.22);
    }

    .chip-c {
        background: rgba(217,119,6,.12);
        color: #b45309;
        border: 1px solid rgba(217,119,6,.22);
    }

    body.night-mode .chip-a {
        color: #86efac;
    }

    body.night-mode .chip-b {
        color: #7dd3fc;
    }

    body.night-mode .chip-c {
        color: #fcd34d;
    }

    .mcard-charts {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        border-bottom: 1px solid var(--border);
    }

    .chart-cell {
        padding: 10px 14px;
        border-right: 1px solid var(--border);
    }

        .chart-cell:last-child {
            border-right: none;
        }

    .chart-cell-label {
        font-size: 9px;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .dt-list {
        padding: 10px 14px 8px;
    }

    .dt-item {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 5px;
    }

    .dt-name {
        font-size: 10px;
        min-width: 90px;
        max-width: 90px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dt-track {
        flex: 1;
        height: 3px;
        background: var(--border);
        border-radius: 2px;
        overflow: hidden;
    }

    .dt-fill {
        height: 100%;
        border-radius: 2px;
        background: var(--danger);
    }

    .dt-min {
        font-size: 10px;
        color: var(--danger);
        min-width: 40px;
        text-align: right;
    }

    .bottom-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 20px;
    }

    .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 18px 20px;
    }

    .panel-title {
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .panel-title span {
            color: var(--accent);
        }

    #aiReportContainer {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 20px;
        display: none;
    }

    .ai-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }

    .ai-badge {
        width: 28px;
        height: 28px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
    }

    .ai-title {
        font-family: var(--font-head);
        font-size: 14px;
        font-weight: 700;
        color: var(--heading);
    }

    .ai-sub {
        font-size: 10px;
        margin-top: 1px;
    }

    #aiReportText {
        white-space: pre-wrap;
        font-size: 12px;
        line-height: 1.7;
        color: var(--card-text);
        border-top: 1px solid var(--border);
        padding-top: 12px;
    }

    .league-table {
        width: 100%;
        border-collapse: collapse;
    }

        .league-table th {
            font-size: 9px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--muted);
            padding: 6px 10px;
            text-align: left;
            border-bottom: 1px solid var(--border);
        }

        .league-table td {
            padding: 8px 10px;
            border-bottom: 1px solid var(--border);
            font-size: 12px;
            vertical-align: middle;
            color: var(--card-text);
        }

        .league-table tr:last-child td {
            border-bottom: none;
        }

    .rank-num {
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 13px;
        color: var(--muted);
    }

    .oee-badge {
        font-family: var(--font-head);
        font-size: 14px;
        font-weight: 700;
    }

    ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    ::-webkit-scrollbar-track {
        background: var(--bg);
    }

    ::-webkit-scrollbar-thumb {
        background: var(--border2);
        border-radius: 3px;
    }

    @@media (max-width: 1024px) {
        .oee-hero {
            grid-template-columns: 1fr 1fr 1fr;
        }

        .kpi-row {
            grid-template-columns: repeat(3, 1fr);
        }

        .machines-grid {
            grid-template-columns: 1fr;
        }

        .bottom-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .kpi-row {
            grid-template-columns: repeat(2, 1fr);
        }

        .oee-hero {
            grid-template-columns: 1fr 1fr;
        }

        .oee-breakdown {
            grid-template-columns: repeat(2, 1fr);
        }

        .mcard-metrics {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<!-- ═══════════════════════════════ TOPBAR ═══════════════════════════════ -->
<div class="topbar">
    <div class="topbar-brand">
        <div class="brand-mark">⚙</div>
        <div>
            <div class="brand-title">OEE Intelligence</div>
