@page
@model TPL_TM.Pages.Downtime_DeleteModel
@{
    ViewData["Title"] = "Delete Downtime Record";
}

<div class="modal fade show" id="deleteDowntimeModal" tabindex="-1"
     aria-labelledby="deleteDowntimeModalLabel" aria-hidden="true" style="display: block;">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteDowntimeModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" aria-label="Close"
                        onclick="window.location.href=redirectUrl">                    
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(Model.errorMessage))
                {
                    <div class="alert alert-danger">@Model.errorMessage</div>
                }
                else
                {
                    <h5 class="text-danger">Are you sure you want to delete this downtime record?</h5>

                    <table class="table table-bordered table-hover table-sm" style="background-color: #fafafa;">
                        <tbody>
                            <tr><th>Downtime (min)</th><td>@Model.downtime.Downtime</td></tr>
                            <tr><th>Reason</th><td>@Model.downtime.ReasonName</td></tr>
                            <tr><th>Shift</th><td>@Model.downtime.Shift</td></tr>
                            <tr><th>Comment</th><td>@Model.downtime.Comment</td></tr>
                        </tbody>
                    </table>

                    <form method="post" asp-page-handler="DeleteDowntime">
                        <input type="hidden" name="Id" value="@Model.downtime.Id" />

                        <button type="submit" class="btn btn-danger w-100">
                            Delete Downtime
                        </button>
                        <a href="/Downtime_Report" class="btn btn-secondary w-100 mt-2">
                            Cancel
                        </a>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var modal = new bootstrap.Modal(document.getElementById('deleteDowntimeModal'), {
                backdrop: 'static',
                keyboard: false
            });
            modal.show();
        });
    </script>
    <script>
        const redirectUrl = "@(
         User.IsInRole("User") ? "/Operator_Index" : "/Downtime_Report")";
    </script>
        
}
