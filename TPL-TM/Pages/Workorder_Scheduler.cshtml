<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
<script>

    document.addEventListener('DOMContentLoaded', async function () {

        const loadingEl = document.getElementById('schedulerLoading');

        const response =
            await fetch('?handler=SchedulerData');

        const data =
            await response.json();
        const allResources = data.resources;
        const allEvents = data.events;

        let selectedLine = null;
        let selectedMachine = null;

        const calendarEl =
            document.getElementById('scheduler');

            const machineLines =
        [...new Set(allResources.map(r => r.machineLine))];

    const lineContainer =
        document.getElementById('machineLineButtons');

    const machineContainer =
        document.getElementById('machineButtons');

    const allLineBtn = document.createElement('button');
        allLineBtn.className = 'btn btn-outline-success btn-sm filter-btn active';
        allLineBtn.textContent = 'All Lines';

        allLineBtn.onclick = () => {
            selectedLine = null;
            selectedMachine = null;

            document.querySelectorAll('#machineLineButtons .filter-btn')
                .forEach(b => b.classList.remove('active'));

            allLineBtn.classList.add('active');

            buildMachineButtons();
            applyFilters();
        };

        lineContainer.appendChild(allLineBtn);

        machineLines.forEach(line => {

            const btn = document.createElement('button');

            btn.className =
                'btn btn-outline-success btn-sm filter-btn';

            btn.textContent = line;

            btn.onclick = () => {

                selectedLine = line;
                selectedMachine = null;

                document.querySelectorAll('#machineLineButtons .filter-btn')
                    .forEach(b => b.classList.remove('active'));

                btn.classList.add('active');

                buildMachineButtons();
                applyFilters();
            };

            lineContainer.appendChild(btn);
        });

        const calendar =
            new FullCalendar.Calendar(calendarEl, {

                height: 820,

                schedulerLicenseKey:
                    'CC-Attribution-NonCommercial',

               initialView: 'resourceTimelineWeek',

               eventMinWidth: 60,

                expandRows: true,

                nowIndicator: true,

                stickyHeaderDates: true,

                stickyFooterScrollbar: true,

                editable: true,

                resourceAreaWidth: '230px',

                resourceGroupField: 'machineLine',

                resourceAreaColumns: [
                    {
                        field: 'title',
                        headerContent: 'Machine'
                    }
                ],

                resourceAreaHeaderContent:
                    'Machines',

                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'resourceTimelineDay,resourceTimelineWeek,resourceTimelineMonth'
                },

                buttonText: {
                    today: 'Today',
                    resourceTimelineDay: 'Day',
                    resourceTimelineWeek: 'Week',
                    resourceTimelineMonth: 'Month'
                },

                


                views: {

                    resourceTimelineDay: {

                        slotDuration: "01:00:00",

                        slotLabelInterval: "01:00:00",

                        slotLabelFormat: {
                            hour: '2-digit',
                            minute: '2-digit',
                            hour12: false
                        },

                        slotMinWidth: 70
                    },

                    resourceTimelineWeek: {

                        slotDuration: { days: 1 },

                        slotLabelInterval: { days: 1 },

                        slotLabelFormat: [
                            {
                                weekday: 'short'
                            },
                            {
                                day: 'numeric'
                            }
                        ],

                        slotMinWidth: 90
                    },

                    resourceTimelineMonth: {

                        slotDuration: { days: 1 },

                        slotLabelInterval: { days: 1 },

                        slotLabelFormat: {
                            day: 'numeric'
                        },

                        slotMinWidth: 90
                    }
                },

                resources:
                    data.resources,

                events:
                    data.events,

               eventContent: function (info) {

                    const qty = info.event.extendedProps.qty;
                    const built = info.event.extendedProps.builtQty;
                    const itemId = info.event.extendedProps.itemId;
                    const itemName = info.event.extendedProps.itemName;
                    const pct = qty > 0
                        ? Math.round((built / qty) * 100)
                        : null;

                    const metaParts = [itemId, itemName].filter(Boolean);
                    const metaText = metaParts.join(' — ');
                    // Format Start & End Time
                    const startTime = info.event.start
                        ? info.event.start.toLocaleTimeString('en-GB', {
                            hour: '2-digit',
                            minute: '2-digit'
                        })
                        : '';
                     const endTime = info.event.end
                        ? info.event.end.toLocaleTimeString('en-GB', {
                            hour: '2-digit',
                            minute: '2-digit'
                        })
                        : '';

                    return {
                        html: `
                            <div class="wo-box" title=" ${startTime} - ${endTime}${info.event.title}${metaText ? ' — ' + metaText : ''}">
                                <span class="wo-title">
                                    ${startTime} - ${endTime}
                                    ${info.event.title}
                                    ${metaText ? ` - <span class="wo-itemid">${metaText}</span>` : ''}
                                </span>
                                ${pct !== null ? `<span class="wo-pct">${pct}%</span>` : ''}
                            </div>
                        `
                    };
                },

                eventDidMount: function (info) {

                    info.el.setAttribute(
                        'data-event-id',
                        info.event.id
                    );
                },

                eventClick: function (info) {

                    document.getElementById('modalWONumber').innerText =
                        info.event.title;

                    JsBarcode("#woBarcode", info.event.title, {
                        format: "CODE128",
                        width: 2,
                        height: 45,
                        displayValue: true,
                        fontSize: 12,
                        textMargin: 2,
                        margin: 0
                    });
                    document.getElementById('modalItemName').innerText =
                        info.event.extendedProps.itemName ?? '';

                    document.getElementById('modalItemId').innerText =
                        info.event.extendedProps.itemId ?? '';

                    document.getElementById('modalMachine').innerText =
                        info.event.getResources()[0]?.title ?? '';

                    document.getElementById('modalQty').innerText =
                        info.event.extendedProps.qty ?? 0;

                    document.getElementById('modalBuiltQty').innerText =
                        info.event.extendedProps.builtQty ?? 0;

                    const p = info.event.extendedProps;

                    document.getElementById("modalStart").innerText =
                        p.plannedStart
                            ? new Date(p.plannedStart).toLocaleDateString('en-GB')
                            : '';

                    document.getElementById("modalEnd").innerText =
                        p.plannedEnd
                            ? new Date(p.plannedEnd).toLocaleDateString('en-GB')
                            : '';

                    document.getElementById("modalActualStart").innerText =
                        p.actualStart
                            ? new Date(p.actualStart).toLocaleDateString('en-GB')
                            : '';

                    document.getElementById("modalActualEnd").innerText =
                        p.actualEnd
                            ? new Date(p.actualEnd).toLocaleDateString('en-GB')
                            : '';

                        const approvalBadge = document.getElementById("approvalBadge");
                        const approvalStatus = p.approvalStatus ?? "";

                        approvalBadge.textContent = approvalStatus || "Not Approved";

                        if (approvalStatus.toLowerCase() === "approved") {
                            approvalBadge.className = "badge bg-light text-success border border-success";
                        }
                        else {
                            approvalBadge.className = "badge bg-danger text-white";
                        }
                    // Product Information
                    document.getElementById("modalProductType").innerText = p.productType ?? "";
                    document.getElementById("modalCMYK").innerText = p.cmyk ?? "";
                    document.getElementById("modalInk1").innerText = p.ink1 ?? "";
                    document.getElementById("modalInk2").innerText = p.ink2 ?? "";
                    document.getElementById("modalInk3").innerText = p.ink3 ?? "";
                    document.getElementById("modalInk4").innerText = p.ink4 ?? "";
                    document.getElementById("modalInk5").innerText = p.ink5 ?? "";
                    document.getElementById("modalCyrelRef1").innerText = p.cyrelRef1 ?? "";
                    document.getElementById("modalCyrelRef2").innerText = p.cyrelRef2 ?? "";
                    document.getElementById("modalVarnish").innerText = p.varnish ?? "";
                    document.getElementById("modalPrima").innerText = p.prima ?? "";
                    document.getElementById("modalVarnish2").innerText = p.varnish2 ?? "";
                    document.getElementById("modalLayout").innerText = p.layout ?? "";

                    // Case Information
                    document.getElementById("modalPICode").innerText = p.piCode ?? "";
                    document.getElementById("modalOBPartNo").innerText = p.obPartNo ?? "";

                    document.getElementById("modalInnerType").innerText = p.innerType ?? "";
                    document.getElementById("modalInnerPartNo").innerText = p.innerPartNo ?? "";

                    document.getElementById("modalInnerLayout").innerText = p.innerLayout ?? "";
                    document.getElementById("modalQtyPerInnerLayer").innerText = p.qtyPerInnerLayer ?? "";

                    document.getElementById("modalCaseWtNet").innerText = p.caseWtNet ?? "";
                    document.getElementById("modalCaseWtGross").innerText = p.caseWtGross ?? "";

                    document.getElementById("modalInnersPerCase").innerText = p.innersPerCase ?? "";
                    document.getElementById("modalCaseBarcode").innerText = p.caseBarcode ?? "";

                    // Pallet Information
                    document.getElementById("modalPalletType").innerText = p.palletType ?? "";
                    document.getElementById("modalPalletBarcode").innerText = p.palletBarcode ?? "";
                    document.getElementById("modalPalletLayers").innerText = p.palletLayers ?? "";
                    
                    document.getElementById("modalQtyPerPallet").innerText = p.qtyPerPallet ?? "";

                      // Pallet Information
                    document.getElementById("modalQtyPerOuter").innerText =
                        p.qtyPerOuter ?? "";

                    document.getElementById("modalCasesPerLayer").innerText =
                        p.casesPerLayer ?? "";

                    document.getElementById("modalCasesPerPallet").innerText =
                        p.casesPerPallet ?? "";

                    document.getElementById("modalPackingDescription").innerText =
                        p.packingDescription ?? "";

                    document.getElementById("modalPalletSize").innerText =
                        p.palletSize ?? "";

                    document.getElementById("modalPalletWtNet").innerText =
                        p.palletWtNet ?? "";

                    document.getElementById("modalPalletWtGross").innerText =
                        p.palletWtGross ?? "";

                    document.getElementById("modalPalletHeight").innerText =
                        p.palletHeight ?? "";

                    document.getElementById("modalPalletDimension").innerText =
                        p.palletDimension ?? "";


                    // Notes
                    document.getElementById("modalPrintNotes").innerText = p.printNotes ?? "";
                    document.getElementById("modalHandStripping").innerText = p.handStripping ?? "";
                    document.getElementById("modalProcessComments").innerText = p.processComments ?? "";
                    document.getElementById("modalCustomerNotes").innerText = p.customerNotes ?? "";

                    const internalId = info.event.id;
                    const workOrderNo = info.event.title;

                    document.getElementById("modalStartShift").href =
                        `/Shift_Entry?id=${internalId}&workorder=${encodeURIComponent(info.event.title)}`;

                    const artworkUrl =
                        info.event.extendedProps.artworkUrl;

                    const artworkBtn =
                        document.getElementById('modalArtworkLink');
                   

                    if (artworkUrl) {

                        artworkBtn.href = artworkUrl;
                        artworkBtn.style.display = 'inline-block';

                    } else {

                        artworkBtn.href = '#';
                        artworkBtn.style.display = 'none';
                    }

                    document.getElementById('modalBomLink').href =
                        `https://5262984.app.netsuite.com/app/accounting/print/hotprint.nl?regular=T&sethotprinter=T&formnumber=171&trantype=workord&id=${internalId}&label=Bill+of+Materials&printtype=bom`;

                    document.getElementById('modalNetSuiteLink').href =
                        `https://5262984.app.netsuite.com/app/accounting/transactions/workord.nl?id=${internalId}&whence=`;

                    new bootstrap.Modal(
                        document.getElementById('workOrderModal')
                    ).show();
                    
                    const tbody = document.getElementById("bomBody");
                    tbody.innerHTML = "";

                    fetch(`?handler=Bom&id=${internalId}`)
                        .then(r => r.json())
                        .then(rows => {

                        tbody.innerHTML = "";

                            rows.forEach(x => {

                                tbody.innerHTML += `
                                    <tr>
                                        <td>${x.quantity}</td>

                                        <td>
                                            <div class="d-flex justify-content-between align-items-start">

                                                <div class="flex-grow-1">
                                                    <div class="fw-semibold">${x.item} - ${x.displayname}</div>

                                                    ${x.description
                                                        ? `<div class="text-muted small">${x.description}</div>`
                                                        : ""}
                                                </div>

                                               <button class="btn btn-sm btn-warning ms-2 request-material-btn"
                                                    data-item="${x.item}"
                                                    data-desc="${x.description ?? ''}"
                                                    data-qty="${Math.ceil(Math.abs(Number(x.quantity)))}"
                                                    data-wo="${info.event.title}"
                                                    data-machine="${info.event.getResources()[0]?.title ?? ''}">
                                                    <i class="bi bi-box-seam"></i>
                                                    Request
                                                </button>

                                            </div>
                                        </td>
                                    </tr>`;
                            });

                            document.querySelectorAll(".request-material-btn").forEach(btn => {

                            btn.addEventListener("click", function () {

                                const wo = this.dataset.wo;
                                const item = this.dataset.item;
                                const desc = this.dataset.desc;
                                const machine = this.dataset.machine;
                                const qty = this.dataset.qty;

                                const url =
                                    `/Request_Inventory?wo=${encodeURIComponent(wo)}`
                                    + `&item=${encodeURIComponent(item)}`
                                    + `&desc=${encodeURIComponent(desc)}`
                                    + `&machine=${encodeURIComponent(machine)}`
                                    + `&qty=${encodeURIComponent(qty)}`;

                                window.open(url, "_blank");
                            });

                        });
                            if (rows.length === 0) {
                                tbody.innerHTML = `
                                    <tr>
                                        <td colspan="2" class="text-center text-muted">
                                            No BOM items found.
                                        </td>
                                    </tr>`;
                            }

                        });
                    },

                eventDrop: function (info) {

                    const payload = {

                        WorkOrderId:
                            info.event.id,

                        MachineName:
                            info.event.getResources()[0].id,

                        StartDate:
                            info.event.start,

                        EndDate:
                            info.event.end
                    };

                    fetch('/api/netsuite/workorder/update', {

                        method: 'POST',

                        headers: {
                            'Content-Type':
                                'application/json'
                        },

                        body:
                            JSON.stringify(payload)

                    })
                        .then(r => {

                            if (!r.ok)
                                throw new Error();

                        })
                        .catch(() => {

                            alert(
                                'Failed to update work order'
                            );

                            info.revert();
                        });
                }

            });

        calendar.render();
        // Refresh scheduler every 15 minutes
           setInterval(async function () {

            try {

                const response = await fetch('?handler=SchedulerData');
                const data = await response.json();

                allResources.length = 0;
                allResources.push(...data.resources);

                allEvents.length = 0;
                allEvents.push(...data.events);

                applyFilters();

                setTimeout(() => {

                    const scrollers =
                        calendarEl.querySelectorAll('.fc-scroller');

                    scrollers.forEach(s => {
                        s.scrollTop = 0;
                    });

                }, 300);

            } catch (e) {
                console.error(e);
            }

        }, 15 * 60 * 1000);

        // ===================== SEARCH =====================

        const searchBox = document.getElementById('searchBox');
        const searchResults = document.getElementById('searchResults');

        const searchIndex = calendar.getEvents().map(e => ({
            id: e.id,
            wo: e.title,
            itemId: e.extendedProps.itemId || '',
            itemName: e.extendedProps.itemName || '',
            machine: e.getResources()[0]?.title || '',
            start: e.start,
            event: e
        }));

        // Remember where the user was before any search jump
        const originalDate = calendar.getDate();
        const originalView = calendar.view.type;
        let highlightTimeout = null;

        searchBox.addEventListener('input', function () {

            const term = this.value.trim().toLowerCase();

            if (term.length < 2) {
                searchResults.style.display = 'none';

                if (term.length === 0) {
                    clearHighlightAndReset();
                }

                return;
            }

            const matches = searchIndex
                .filter(x =>
                    x.wo.toLowerCase().includes(term) ||
                    x.itemId.toLowerCase().includes(term) ||
                    x.itemName.toLowerCase().includes(term)
                )
                .slice(0, 10);

            searchResults.innerHTML = '';

            matches.forEach(match => {

                const item = document.createElement('button');

                item.type = 'button';

                item.className =
                    'list-group-item list-group-item-action';

                item.innerHTML = `
                    <div class="fw-bold">${match.wo}</div>

                    <div class="small text-primary">
                        ${match.itemId || ''}
                    </div>

                    <div class="small text-muted">
                        ${match.itemName || ''}
                    </div>

                    <div class="small">
                        <i class="bi bi-cpu"></i> ${match.machine}
                    </div>
                `;

                item.onclick = () =>
                    jumpToWorkOrder(match.event);

                searchResults.appendChild(item);
            });

            searchResults.style.display =
                matches.length ? 'block' : 'none';
        });

        function jumpToWorkOrder(event) {

            searchResults.style.display = 'none';

            searchBox.value = event.title;

            calendar.gotoDate(event.start);

            setTimeout(() => {

                clearHighlight();

                const eventEl =
                    document.querySelector(
                        `[data-event-id="${event.id}"]`
                    );

                if (eventEl) {

                    eventEl.classList.add('search-highlight');

                    eventEl.scrollIntoView({
                        behavior: 'smooth',
                        block: 'center',
                        inline: 'center'
                    });

                    highlightTimeout = setTimeout(() => {
                        clearHighlight();
                    }, 5000);
                }

            }, 300);
        }

        function clearHighlight() {

            if (highlightTimeout) {
                clearTimeout(highlightTimeout);
                highlightTimeout = null;
            }

            document
                .querySelectorAll('.search-highlight')
                .forEach(x => {
                    x.classList.remove('search-highlight');
                    // force a clean reset so no residual scale/shadow lingers
                    x.style.transform = '';
                    x.style.boxShadow = '';
                });
        }

        function clearHighlightAndReset() {
            clearHighlight();
            calendar.changeView(originalView, originalDate);
        }

        function buildMachineButtons() {

        machineContainer.innerHTML = '';

        let machines = allResources;

        if (selectedLine) {
            machines =
                machines.filter(x =>
                    x.machineLine === selectedLine);
        }

        const allBtn = document.createElement('button');

        allBtn.className =
            'btn btn-outline-success btn-sm filter-btn active';

        allBtn.textContent = 'All Machines';

        allBtn.onclick = () => {

            selectedMachine = null;

            machineContainer
                .querySelectorAll('.filter-btn')
                .forEach(b => b.classList.remove('active'));

            allBtn.classList.add('active');

            applyFilters();
        };

        machineContainer.appendChild(allBtn);

        machines.forEach(machine => {

            const btn = document.createElement('button');

            btn.className =
                'btn btn-outline-success btn-sm filter-btn';

            btn.textContent = machine.title;

            btn.onclick = () => {

                selectedMachine = machine.id;

                machineContainer
                    .querySelectorAll('.filter-btn')
                    .forEach(b => b.classList.remove('active'));

                btn.classList.add('active');

                applyFilters();
            };

            machineContainer.appendChild(btn);
        });
    }
        
    function applyFilters() {

        let resources = allResources;

        if (selectedLine) {

            resources =
                resources.filter(r =>
                    r.machineLine === selectedLine);
        }

        if (selectedMachine) {

            resources =
                resources.filter(r =>
                    r.id === selectedMachine);
        }

        const resourceIds =
            resources.map(r => r.id);

        const events =
            allEvents.filter(e =>
                resourceIds.includes(e.resourceId));

        calendar.batchRendering(() => {

            calendar.getResources()
                .forEach(r => r.remove());

            calendar.getEvents()
                .forEach(e => e.remove());

            resources.forEach(r =>
                calendar.addResource(r));

            events.forEach(e =>
                calendar.addEvent(e));
        });
    }

    const filterHeader =
        document.getElementById("filterHeader");

    const filterPanel =
        document.getElementById("machineFilters");

    const filterIcon =
        document.getElementById("filterIcon");

    filterHeader.addEventListener("click", () => {

        if (filterPanel.style.display === "none") {

            filterPanel.style.display = "block";
            filterIcon.style.transform = "rotate(180deg)";

        } else {

            filterPanel.style.display = "none";
            filterIcon.style.transform = "rotate(0deg)";
        }
    });

    buildMachineButtons();

        // Clicking outside the search box/results closes the dropdown
